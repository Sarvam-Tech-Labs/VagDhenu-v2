[
  {
    "start_s": 0.0,
    "end_s": 10.0,
    "ctc": "धर्मच्छेत्रे गुरुक्षेत्रे नमो भीताायुधुत्त मा मकापाहव"
  },
  {
    "start_s": 8.0,
    "end_s": 18.0,
    "ctc": "मामकापलवचकिमाकूगतस"
  },
  {
    "start_s": 16.0,
    "end_s": 26.0,
    "ctc": "दृष्ट्वा सूपाण्डवाणी तं भूयं भूयू धनःस्तदा आच"
  },
  {
    "start_s": 24.0,
    "end_s": 34.0,
    "ctc": "आच्यमभसङ्ग राजा वचनमाप्रति"
  },
  {
    "start_s": 32.0,
    "end_s": 42.0,
    "ctc": "वसैतां पाणपुत्राणामाचजमतिञ्चमं भूवन्"
  },
  {
    "start_s": 40.0,
    "end_s": 50.0,
    "ctc": "भूणां दृपदपुत्रेण सभशिष्रेण धीमता"
  },
  {
    "start_s": 48.0,
    "end_s": 58.0,
    "ctc": "अत्र श्रूर महीश्वशा धीमाजुनसमाजधी"
  },
  {
    "start_s": 56.0,
    "end_s": 66.0,
    "ctc": "विजूधानुविरातश्च नृपादश्च महक"
  },
  {
    "start_s": 64.0,
    "end_s": 74.0,
    "ctc": "दृष्टके तूश्चेतिितान काासिराजश्च वीर्यवान् कुरु"
  },
  {
    "start_s": 72.0,
    "end_s": 82.0,
    "ctc": "यवान् पुरुधी कुन्तिभोयश्च सैव्याश्च नरपुङ्गवः"
  },
  {
    "start_s": 80.0,
    "end_s": 90.0,
    "ctc": "विदामनुश्च विक्रान् च उत्तमौजास ीजवान्"
  },
  {
    "start_s": 88.0,
    "end_s": 98.0,
    "ctc": "युान् सौभद्रदौदीयाश्च सर्वैव महर्थाः"
  },
  {
    "start_s": 96.0,
    "end_s": 106.0,
    "ctc": "तस्मापं तु विशिष्ट्या जीतान् निबूतविजोत्तम नार"
  },
  {
    "start_s": 104.0,
    "end_s": 114.0,
    "ctc": "नायकासन्नश्यसज्ञर्थंतां"
  },
  {
    "start_s": 112.0,
    "end_s": 122.0,
    "ctc": "भवान्ीष्मश्चापर्णस्य कृपश्च समितिं यया असत्यम्"
  },
  {
    "start_s": 120.0,
    "end_s": 130.0,
    "ctc": "असत्यामाधिकर्णश्च सोमदत्ती सखैव च"
  },
  {
    "start_s": 128.0,
    "end_s": 138.0,
    "ctc": "अन्ये चां बहो श्रूरां मदधे त स जीवित नानासत्तप्रहरणम्"
  },
  {
    "start_s": 136.0,
    "end_s": 146.0,
    "ctc": "मणा तत्तप्रहरणौ सलदीदृदपृधाानदा"
  },
  {
    "start_s": 144.0,
    "end_s": 154.0,
    "ctc": "आपृज्यार्थं तदस्मातं बलं भष्मा विदक्षितम् ब्यार्थं"
  },
  {
    "start_s": 152.0,
    "end_s": 162.0,
    "ctc": "पर्यास समे तषां बलं भाव्यहितं हयमेषु च चत्"
  },
  {
    "start_s": 160.0,
    "end_s": 170.0,
    "ctc": "परमेषु च सर्वेषु भृजताभावमवस्थितः भीणुमेवाभिदशन्तु"
  },
  {
    "start_s": 168.0,
    "end_s": 178.0,
    "ctc": "श सर्वै दश्यर्थं जनय नहर्षम्"
  },
  {
    "start_s": 176.0,
    "end_s": 186.0,
    "ctc": "जनयं नहर्षं कुर्वधपितामह सिमनादं विनदो्चैशङ्खम्"
  },
  {
    "start_s": 184.0,
    "end_s": 194.0,
    "ctc": "धर्मौ सृतःः शङ्खाश्च धीर्यस्य पवनाः"
  },
  {
    "start_s": 192.0,
    "end_s": 202.0,
    "ctc": "स्यं परवानोमुखाः सहसैःबाप्या"
  },
  {
    "start_s": 200.0,
    "end_s": 210.0,
    "ctc": "सहसैास्यांशब्द रतःसी सैहवै"
  },
  {
    "start_s": 208.0,
    "end_s": 218.0,
    "ctc": "ैहवैयुक्तेमाधीषन्ननिस्थितौ माधवः पाण्डवश्च"
  },
  {
    "start_s": 216.0,
    "end_s": 226.0,
    "ctc": "पाण्डवश्चैव दिग््वौ शङ्कौ प्रदर्मसो"
  },
  {
    "start_s": 224.0,
    "end_s": 234.0,
    "ctc": "पञ्चरणंषीकीशं दीवदत्तं धनन्यय वन्द्रं दद्मौ मह"
  },
  {
    "start_s": 232.0,
    "end_s": 242.0,
    "ctc": "न्दद्मौ धीमकर्मा विभू नरः अनन्तबजन्"
  },
  {
    "start_s": 240.0,
    "end_s": 250.0,
    "ctc": "अनन्त विजरायाः कृन्तिपुत्र गिधी्थिर नहदस्तहदीवः"
  },
  {
    "start_s": 248.0,
    "end_s": 258.0,
    "ctc": "दामहुस्तदीव सुभोष मणिपूस्तकश"
  },
  {
    "start_s": 256.0,
    "end_s": 266.0,
    "ctc": "काश्यस्य परमह्याससिकण्डीकमहारध दिश्च भूम्नु विराट"
  },
  {
    "start_s": 264.0,
    "end_s": 274.0,
    "ctc": "श्च धूम्नुविराटश्च शास्ततीशापराितूदूदौपदीयान्"
  },
  {
    "start_s": 272.0,
    "end_s": 282.0,
    "ctc": "बधूधपदीयाश्च सर्वशौपधीपते सौवद्रश्च महावाहौ"
  },
  {
    "start_s": 280.0,
    "end_s": 290.0,
    "ctc": "महबाहौ शमुखानर्मघोूदाशणं"
  },
  {
    "start_s": 288.0,
    "end_s": 298.0,
    "ctc": "राष्टां हृदयणी बधारय नमश्च पृथिवं चैव तमूल"
  },
  {
    "start_s": 296.0,
    "end_s": 306.0,
    "ctc": "तुमूलोपर् अतः प्रवस्थितान् दृष्ट्वारासुरास्तः"
  },
  {
    "start_s": 304.0,
    "end_s": 314.0,
    "ctc": "रासुरास्तङ्कपिधय प्रव्तेःशससङ्पाति धनुूवृद्ग"
  },
  {
    "start_s": 312.0,
    "end_s": 322.0,
    "ctc": "धनुूवद्ाणविशीकीथं तदावह विदामाह मही"
  },
  {
    "start_s": 320.0,
    "end_s": 330.0,
    "ctc": "निदामाह महीपते सहीेनयोर्वयोर्मध्ये रथं स्थापय मे सिता"
  },
  {
    "start_s": 328.0,
    "end_s": 338.0,
    "ctc": "जावदीतान् विरीक्षीहं जोसुकामानबव"
  },
  {
    "start_s": 336.0,
    "end_s": 346.0,
    "ctc": "धुगामान ववस्थितां कया स्वैमया सजूरम्यं"
  },
  {
    "start_s": 344.0,
    "end_s": 354.0,
    "ctc": "तस्मिन् रहः सदे जूषमाणानवेक्षीहं जान"
  },
  {
    "start_s": 352.0,
    "end_s": 362.0,
    "ctc": "हं जायेते त समागतः नास्त्रष्टाश्च दुर्र्वुद्धीः"
  },
  {
    "start_s": 360.0,
    "end_s": 370.0,
    "ctc": "युद्धीप्यसहीशसं"
  },
  {
    "start_s": 368.0,
    "end_s": 378.0,
    "ctc": "एवमुक्तं श्रीके स ग्रकेशेनभारत सेनयो"
  },
  {
    "start_s": 376.0,
    "end_s": 386.0,
    "ctc": "सेनयोरृहणमध्ये सापै सानशोत्तमंष्"
  },
  {
    "start_s": 384.0,
    "end_s": 394.0,
    "ctc": "भीष्मद्रूणप्रमूखत सर्वीधां समीक्षित उवाचोः पार्थपुषीः"
  },
  {
    "start_s": 392.0,
    "end_s": 402.0,
    "ctc": "ोः पाथपुशीजान् समो भीतान् कुरूमिति आचार्योन्मा"
  },
  {
    "start_s": 400.0,
    "end_s": 410.0,
    "ctc": "आचार्य मासुरानुभगन् पुत्रान् पौत्रांतींत"
  },
  {
    "start_s": 408.0,
    "end_s": 418.0,
    "ctc": "ससुुर सुलांस्यैवसीनयो युभयोरभि"
  },
  {
    "start_s": 416.0,
    "end_s": 426.0,
    "ctc": "तान् समिक्ष शोकौन्तीयौ सर्वाणुबन्धूर्णवस्थितान् कृभयात्"
  },
  {
    "start_s": 424.0,
    "end_s": 434.0,
    "ctc": "ान् कृपयापया विष्टु विसीदन्दमात्रेु"
  },
  {
    "start_s": 432.0,
    "end_s": 442.0,
    "ctc": "दृष्टीवं सजनं कृष्णां विदुःषंसमुपस्थितं श्रीदन्ति"
  },
  {
    "start_s": 440.0,
    "end_s": 450.0,
    "ctc": "सीदन्ती मुदत्राणि मुखं चापविशुष्य ग्ीपुतश्च शरीरम्"
  },
  {
    "start_s": 448.0,
    "end_s": 458.0,
    "ctc": "दीपुतः च स वीरोमी सोमहर्षश्च जाति वााण्ववं संंसतीह"
  },
  {
    "start_s": 456.0,
    "end_s": 466.0,
    "ctc": "व संसतीहस्ता तस्यैव परिदै न तू सपनमहमवत्भावत"
  },
  {
    "start_s": 464.0,
    "end_s": 474.0,
    "ctc": "अ भ्रमज्जीवसाम निमित्तानि च पश्यामि"
  },
  {
    "start_s": 472.0,
    "end_s": 482.0,
    "ctc": "विपरीताानि केशभ नच स्वेव नोपश्यामि सत सजन"
  },
  {
    "start_s": 480.0,
    "end_s": 490.0,
    "ctc": "सत्या सजनमाह न काङ्खी विजयं कृष्णं नच राज्यं सुखानि च"
  },
  {
    "start_s": 488.0,
    "end_s": 498.0,
    "ctc": "किन्दोरासीनगोविन्दो वैते वा"
  },
  {
    "start_s": 496.0,
    "end_s": 506.0,
    "ctc": "जीतावथीताङ्क्षिरं राज्यं भूवः सुखानि च"
  },
  {
    "start_s": 504.0,
    "end_s": 514.0,
    "ctc": "सो हिमैवथिताायुद्धि प्राणांु ससघ"
  },
  {
    "start_s": 512.0,
    "end_s": 522.0,
    "ctc": "वाचग कितरूप पुत्रां प्रृभैवाचासितामह माथुला"
  },
  {
    "start_s": 520.0,
    "end_s": 530.0,
    "ctc": "मातुुल सुसरा प्रौसा स्यालास विनप्रः एतान्न हन्तुमिच्छत्"
  },
  {
    "start_s": 528.0,
    "end_s": 538.0,
    "ctc": "एीतान्न हन्तुमिच्छामघ्रतो पि मधुसूदनम् अपि तैलभ्य राज्यस्य"
  },
  {
    "start_s": 536.0,
    "end_s": 546.0,
    "ctc": "राज्यस्य भीतककृते निहत्य धाास्रास्याङ्ग्य"
  },
  {
    "start_s": 544.0,
    "end_s": 554.0,
    "ctc": "तावीतीीशाचनादनौ वाासमीवात् सरेरितस्मान् वस्तैतानम्"
  },
  {
    "start_s": 552.0,
    "end_s": 562.0,
    "ctc": "वस्तैतानास तस्मान्ना भयं हन्तुरासरशान्"
  },
  {
    "start_s": 560.0,
    "end_s": 570.0,
    "ctc": "दसराशान् समान्ङ्गवान् स्वजनंीकतं हत्वा सुखनश्यावमान"
  },
  {
    "start_s": 568.0,
    "end_s": 578.0,
    "ctc": "जग्दैपे तेन पशन्तिल्वोोपो हतचेतसम्"
  },
  {
    "start_s": 576.0,
    "end_s": 586.0,
    "ctc": "हतीतसं कुलक्षयो कृतं दूतं मित्रद्रोहीतप"
  },
  {
    "start_s": 584.0,
    "end_s": 594.0,
    "ctc": "कथं नस्माभि कमाारमान्निवसितं कलतः"
  },
  {
    "start_s": 592.0,
    "end_s": 602.0,
    "ctc": "कुलक्षकृतं भूतं वपत्सदीना"
  },
  {
    "start_s": 600.0,
    "end_s": 610.0,
    "ctc": "कुलसैै प्रनश्यन्ति कुलधर्मासनासन धर्म नस्ति कुलकृ"
  },
  {
    "start_s": 608.0,
    "end_s": 618.0,
    "ctc": "मेनस्तेलः कृष्णर्मविध अधर्माभीववात् कृष्णौ"
  },
  {
    "start_s": 616.0,
    "end_s": 626.0,
    "ctc": "धीववा कृष्णं प्रदुशन्ती कुल त्रिय त्रीसुदुष्ट सुपस्मय जायस"
  },
  {
    "start_s": 624.0,
    "end_s": 634.0,
    "ctc": "शङ्करो लोकायैवं कुलघनानां कुलसचम्"
  },
  {
    "start_s": 632.0,
    "end_s": 642.0,
    "ctc": "ध्मााणां कुलस्त च वतन्ती कितूोधीषां लुप्तौकिन्दोदपप्रिया"
  },
  {
    "start_s": 640.0,
    "end_s": 650.0,
    "ctc": "दोषैरेकै गलगाणां वणशं करपकै उत्साहम्"
  },
  {
    "start_s": 648.0,
    "end_s": 658.0,
    "ctc": "उत्सादन्ती जातिधर्मां कुलोर्"
  },
  {
    "start_s": 656.0,
    "end_s": 666.0,
    "ctc": "उत्तन्यो कुलधर्माणां मनुषणां जनादनं नरकतं वातु"
  },
  {
    "start_s": 664.0,
    "end_s": 674.0,
    "ctc": "ं वास भवती व्याानु अहो वतो महामत्पापं"
  },
  {
    "start_s": 672.0,
    "end_s": 682.0,
    "ctc": "महत्पापं कत्तंवुसिताभयं जगराज्य सुुभरूेनन्तं"
  },
  {
    "start_s": 680.0,
    "end_s": 690.0,
    "ctc": "अन्तं हृ सजनंगतः हृदिमामप्रतिकारमस"
  },
  {
    "start_s": 688.0,
    "end_s": 698.0,
    "ctc": "महस्रं ससृपाणयोरात्रसाहरणेन्यन्मे"
  },
  {
    "start_s": 696.0,
    "end_s": 706.0,
    "ctc": "तन्मे धीमतरंे सञ्जयवाच एवमुक्त्यार्जुनःथाांसीरसूपस्य"
  },
  {
    "start_s": 704.0,
    "end_s": 714.0,
    "ctc": "मनत्थाङ्कीरसूपस्तूपावित विसिज्ज ससरं शापं पूपो संंवीर मानसः"
  },
  {
    "start_s": 712.0,
    "end_s": 722.0,
    "ctc": "तर्थु श्रीमदभो भगवद्गीतासु पंक्षस्तु ब्रह्मविद्यायां योगधास्ते"
  },
  {
    "start_s": 720.0,
    "end_s": 730.0,
    "ctc": "योगशास्त्रे श्रीकृष्णार्जुनासनवादे अर्जुनाप्रहाद योगनामा प्रथधय"
  },
  {
    "start_s": 728.0,
    "end_s": 730.31,
    "ctc": "मधीःणोायी"
  }
]