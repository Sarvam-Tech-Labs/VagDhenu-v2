[
  {
    "start_s": 0.0,
    "end_s": 10.0,
    "ctc": "कमद्भगवत्सितोस्या श्रभगवानुर्वच इमं विवत्सती"
  },
  {
    "start_s": 6.0,
    "end_s": 16.0,
    "ctc": "इमं विवसती यूगं प्र्तवानहमभयं विवशनोमि"
  },
  {
    "start_s": 12.0,
    "end_s": 22.0,
    "ctc": "नहमभयं विवश्योन्मनभिप्राहामनूरिथकविब्रवः"
  },
  {
    "start_s": 18.0,
    "end_s": 28.0,
    "ctc": "एवं परं पराप्रापमिमाजर्षयो विधुःः"
  },
  {
    "start_s": 24.0,
    "end_s": 34.0,
    "ctc": "प्रापमिमङ्गाजर्षयो विदुः सकालेनीहुमुहता जूवुर्नष्ट परं"
  },
  {
    "start_s": 30.0,
    "end_s": 40.0,
    "ctc": "देनीहुमुहता जूवुर्न्नष्ट परं तप"
  },
  {
    "start_s": 36.0,
    "end_s": 46.0,
    "ctc": "अपरं भवधून्म परं जन्मभिवक्षतः कथोमि"
  },
  {
    "start_s": 42.0,
    "end_s": 52.0,
    "ctc": "जन्मभिवक्षतः कथो मीतद्ज्ञानीयां समादौग प्रमाणिषीः"
  },
  {
    "start_s": 48.0,
    "end_s": 58.0,
    "ctc": "इति भगवान् वा बहुनी मे पदितानिी जनम्"
  },
  {
    "start_s": 54.0,
    "end_s": 64.0,
    "ctc": "बहुनि मे पदितानि जनवाणी तवचार तान् नहं वीद सर्वर्वाणि नत्र"
  },
  {
    "start_s": 60.0,
    "end_s": 70.0,
    "ctc": "तान् नहं वीद सर्वर्वाणि न सम्भक्षपनन्तमं अजो स"
  },
  {
    "start_s": 66.0,
    "end_s": 76.0,
    "ctc": "अजो पि सन्न्यभयात् मां भूतानामश्वरोपिि सन्"
  },
  {
    "start_s": 72.0,
    "end_s": 82.0,
    "ctc": "भूतानामितुरूपिसन् प्रतिदष्यामधिष्ठाय सम्भवाम्यात"
  },
  {
    "start_s": 78.0,
    "end_s": 88.0,
    "ctc": "सम्भवाम्यातु मय्य यदाजदाकी धर्मशख्लणि"
  },
  {
    "start_s": 84.0,
    "end_s": 94.0,
    "ctc": "यदा यदति धर्मस्य भलणी भवति भारतम् अभुत्तानमधर्मस्य"
  },
  {
    "start_s": 90.0,
    "end_s": 100.0,
    "ctc": "अभुत्त्यानमधर्मस्य कदा स्मं सुृजामहम् परित्राणाय"
  },
  {
    "start_s": 96.0,
    "end_s": 106.0,
    "ctc": "परित्राणाय साधुनां विनाशाय च दुष्कृतां धर्मम्"
  },
  {
    "start_s": 102.0,
    "end_s": 112.0,
    "ctc": "विनाशाय च दुष्कृताां धर्मसंस्थापनार्थाय सम्भवानी धीधुधीः"
  },
  {
    "start_s": 108.0,
    "end_s": 118.0,
    "ctc": "सम्भवान जन्मकर्म च मे दिव्या मं"
  },
  {
    "start_s": 114.0,
    "end_s": 124.0,
    "ctc": "जन्मकर्म च मे दिव्यामेवं जूर्वतिित तस तस्यादीहं पुनर्जनम्"
  },
  {
    "start_s": 120.0,
    "end_s": 130.0,
    "ctc": "तस्यापिहं पुनर्जन्म नैतिमामििति कौस्य"
  },
  {
    "start_s": 126.0,
    "end_s": 136.0,
    "ctc": "विितुरावुभयक्रूढा मन्वयामामुपायः"
  },
  {
    "start_s": 132.0,
    "end_s": 142.0,
    "ctc": "विितुरावुभयक्रूधा मनमयामामुपासितः बहुवो ज्ञानतमसा भूत"
  },
  {
    "start_s": 138.0,
    "end_s": 148.0,
    "ctc": "बहवो ज्ञानतमसा भूत मदभावमा कृतः"
  },
  {
    "start_s": 144.0,
    "end_s": 154.0,
    "ctc": "ये यथा मां प्रवदन्ते तांस्तथैव भजामामहम्"
  },
  {
    "start_s": 150.0,
    "end_s": 160.0,
    "ctc": "तांस्तथैव भजामहम् ममो व तानुवर्तन्ति मनुष्या पासष"
  },
  {
    "start_s": 156.0,
    "end_s": 166.0,
    "ctc": "नुष्यापास सर्वश काङ्खन्त्य करुणां"
  },
  {
    "start_s": 162.0,
    "end_s": 172.0,
    "ctc": "काङ्ख च करुणां सिद्धिं व्यजन्तपिहृतः"
  },
  {
    "start_s": 168.0,
    "end_s": 178.0,
    "ctc": "क्षिप्रं ही मानुसे लोके सिद्धे भवति कर्मयाम्"
  },
  {
    "start_s": 174.0,
    "end_s": 184.0,
    "ctc": "नमाङ् कर्माणि लिम्पन्ती नमे कर्मफले"
  },
  {
    "start_s": 180.0,
    "end_s": 190.0,
    "ctc": "कमाणि लिम्पन्तीनमे कर्मफले स्यः इतीमां जोभिजानाकक"
  },
  {
    "start_s": 186.0,
    "end_s": 196.0,
    "ctc": "इतितीमाञजोभिजनाति कर्मभीण स बधते"
  },
  {
    "start_s": 192.0,
    "end_s": 202.0,
    "ctc": "एवं गत्वा कृतं कर्म उुद््बैरभीमुमोक्षुभि"
  },
  {
    "start_s": 198.0,
    "end_s": 208.0,
    "ctc": "उद्बैरभीमुमोसविी कुरुकर्मैव तस्मात् तं उबप"
  },
  {
    "start_s": 204.0,
    "end_s": 214.0,
    "ctc": "तस्मात् तं पूर्वै पूर्वोत्तरं कृतम् किं कर्म किमकर्मेति"
  },
  {
    "start_s": 210.0,
    "end_s": 220.0,
    "ctc": "किं कर्मा किमकर्मेति गभयुः पत्रबूहिता तस्मै कर्मप्रवृक्ष्याण"
  },
  {
    "start_s": 216.0,
    "end_s": 226.0,
    "ctc": "तस्तै कर्म प्रवक्ष्यामि जडज्ञनस्या मोक्षसी सुभार्म"
  },
  {
    "start_s": 222.0,
    "end_s": 232.0,
    "ctc": "कर्मणोय्यपि्यं बोदव्यं च्याभिः"
  },
  {
    "start_s": 228.0,
    "end_s": 238.0,
    "ctc": "बोद्धव्यंञ्च्याभिकार्मणाम् अकर्मणश्च बोद्धव्यं गहन"
  },
  {
    "start_s": 234.0,
    "end_s": 244.0,
    "ctc": "अकर्मणश्च बोद्ध्यव्यं गनाकर्मणो गतिः कर्मण्याम्"
  },
  {
    "start_s": 240.0,
    "end_s": 250.0,
    "ctc": "कर्माण य आपश्येत् नकर्मणी च कर्मयः"
  },
  {
    "start_s": 246.0,
    "end_s": 256.0,
    "ctc": "दकर्मणी च कर्मजः स बुद्धिमान् मनुष्येषु सधुषाः"
  },
  {
    "start_s": 252.0,
    "end_s": 262.0,
    "ctc": "धीानुमनुष्येषु सदुषा विष्णकर्मकीः य सर्वे समारम्भः"
  },
  {
    "start_s": 258.0,
    "end_s": 268.0,
    "ctc": "यत् सर्वी समारम्भाः कामसङ्कल्पपर्जिताः"
  },
  {
    "start_s": 264.0,
    "end_s": 274.0,
    "ctc": "ल्पपरिजिता ज्ञानग्नीदग्धकर्र्मानं समाहूण्वितं बु"
  },
  {
    "start_s": 270.0,
    "end_s": 280.0,
    "ctc": "समाहूपणणितंबुधा तस्याकर्मफलासङ्गं"
  },
  {
    "start_s": 276.0,
    "end_s": 286.0,
    "ctc": "तस्या कर्मफलासङ्गं निततृप्तो निराश्रया कर्मन्न भीत्"
  },
  {
    "start_s": 282.0,
    "end_s": 292.0,
    "ctc": "राश्रया परमन्नभी प्रविशोकी नैव कं किञ्चित्त्तर"
  },
  {
    "start_s": 288.0,
    "end_s": 298.0,
    "ctc": "नैव कं किञ्चि करोति स निराशी चतिति समात्मा"
  },
  {
    "start_s": 294.0,
    "end_s": 304.0,
    "ctc": "निराशी चतसिद्ध्यमात्मां सप्तसर्वपरिग्रहा शारिरं केवलं कर्म"
  },
  {
    "start_s": 300.0,
    "end_s": 310.0,
    "ctc": "शारिरं केवलं कर्म कुर्बन्नााप्नधिकीष"
  },
  {
    "start_s": 306.0,
    "end_s": 316.0,
    "ctc": "जदिच्यालावशन्तु सो सन्दासीत"
  },
  {
    "start_s": 312.0,
    "end_s": 322.0,
    "ctc": "िथ्यालावसन्तुष्टो सन्धासीतो विमसर सवसिद्ध्यावसिद्धौ च भत्यापि"
  },
  {
    "start_s": 318.0,
    "end_s": 328.0,
    "ctc": "समसिद्ध्यावसिद्धौ च प्रित्यापी न निबद्धति गतः सङ्गस्य मुक्तस्य"
  },
  {
    "start_s": 324.0,
    "end_s": 334.0,
    "ctc": "गतः सङ्गस्य मुक्तस्य ज्ञानवस्थितसीतस"
  },
  {
    "start_s": 330.0,
    "end_s": 340.0,
    "ctc": "जज्ञाया्चरसूः कर्म समग्रं प्रविलीयते"
  },
  {
    "start_s": 336.0,
    "end_s": 346.0,
    "ctc": "ब्रह्मार्पणं ब्रह्महवी ब्रह्माग्नौ ब्रह्मणा हुतौै"
  },
  {
    "start_s": 342.0,
    "end_s": 352.0,
    "ctc": "ब्रह्महवी ब्रह्माग्नौ ब्रह्मणहुतम् ब्रह्म न तेन कन्तव्य्यं ब्रह्मसन्"
  },
  {
    "start_s": 348.0,
    "end_s": 358.0,
    "ctc": "मैन सेन गन्तव्यं ब्रह्मसन्मसमाधिनाम् दैवमवापरीज"
  },
  {
    "start_s": 354.0,
    "end_s": 364.0,
    "ctc": "दैवमवापरीजं जूमिनो पर्युपासती ब्रह्माग्नाापपरी"
  },
  {
    "start_s": 360.0,
    "end_s": 370.0,
    "ctc": "ब्रह्माग्नाापपरीह्यस्य जगीनै गोपजूहति"
  },
  {
    "start_s": 366.0,
    "end_s": 376.0,
    "ctc": "सूत्रादीनिन्द्रियान्ननि चङ्गमहान्नि शृू"
  },
  {
    "start_s": 372.0,
    "end_s": 382.0,
    "ctc": "सङ्गमानान्नि सुजूवति सप्ताद विषयान्यन्य"
  },
  {
    "start_s": 378.0,
    "end_s": 388.0,
    "ctc": "वत्तादिं विषयानन इन्द्रि्याग्मी शुजुवती"
  },
  {
    "start_s": 384.0,
    "end_s": 394.0,
    "ctc": "सर्वाणी इन्द्रियकर्माणि प्राणकर्माणि चापः"
  },
  {
    "start_s": 390.0,
    "end_s": 400.0,
    "ctc": "प्राणकर्माणि शापरे आपसंकमजूगग्नौ धुवती ज्ञान च"
  },
  {
    "start_s": 396.0,
    "end_s": 406.0,
    "ctc": "ापसंमजूगग्नौ जूवस ज्ञानदीकृ दृभजज्ञात् कपूजज्ञात्"
  },
  {
    "start_s": 402.0,
    "end_s": 412.0,
    "ctc": "दृभजिज्ञा कपूजज्ञा यूुजिज्ञास्तथाापीः श्राद्धायो ज्ञानजिज्ञाश्च"
  },
  {
    "start_s": 408.0,
    "end_s": 418.0,
    "ctc": "श्राद्धायो ज्ञानजज्ञास्य जतयूशंसितभ्रृतः"
  },
  {
    "start_s": 414.0,
    "end_s": 424.0,
    "ctc": "अपाणे जवतीी प्राणं प्राणे पाणं तथा परे"
  },
  {
    "start_s": 420.0,
    "end_s": 430.0,
    "ctc": "ाणीपाणंथा हे प्राणापाणवतीरुद्या प्राणायामपि"
  },
  {
    "start_s": 426.0,
    "end_s": 436.0,
    "ctc": "मानीरुद्याप्राणायाम प्रायण अपरीणयताहारा प्राणाणा"
  },
  {
    "start_s": 432.0,
    "end_s": 442.0,
    "ctc": "अपरी निरताहारा प्राणाणां प्राणी सुजुवति सर्वे प्रीते जगवीदौ"
  },
  {
    "start_s": 438.0,
    "end_s": 448.0,
    "ctc": "सर्वे प्रेते जगज्ञविदो जज्ञा कपििता कल्मषाम्"
  },
  {
    "start_s": 444.0,
    "end_s": 454.0,
    "ctc": "जज्ञासिश्चांसो भूजो शान्तिब्रह्मसनातनम्"
  },
  {
    "start_s": 450.0,
    "end_s": 460.0,
    "ctc": "शान्ति ब्रह्मसनातनम् नायं लूकसजज्ञस्य कुतन्याहुत्"
  },
  {
    "start_s": 456.0,
    "end_s": 466.0,
    "ctc": "जज्ञस्य कुतनज्ञ कुरुषत्तमाम् एवं बहुविधा जज्ञां वसृता"
  },
  {
    "start_s": 462.0,
    "end_s": 472.0,
    "ctc": "एवं बहुविधा जज्ञान् विसृता ब्रह्मणोमुुखे कर्मजाण विद्धितान् सर्वान्"
  },
  {
    "start_s": 468.0,
    "end_s": 478.0,
    "ctc": "कर्मर्याणि विद्धितान् सर्वनैव व्यर्ता विमुक्षसि"
  },
  {
    "start_s": 474.0,
    "end_s": 484.0,
    "ctc": "रयान्दृत्वमया जज्ञा ज्ञानजज्ञाः परं तप"
  },
  {
    "start_s": 480.0,
    "end_s": 490.0,
    "ctc": "ज्ञानजगाः परं तप सर्वं कर्माखिलं प्रस्य ज्ञाने परी"
  },
  {
    "start_s": 486.0,
    "end_s": 496.0,
    "ctc": "ाप ज्ञाने परि समापति तस्ितीपणिपतिेन परि"
  },
  {
    "start_s": 492.0,
    "end_s": 502.0,
    "ctc": "द्वदीपणिपाादन परिप्रश्नेन सेवयां उपदेक्षन्ति"
  },
  {
    "start_s": 498.0,
    "end_s": 508.0,
    "ctc": "उपदीक्षन्ति ते ज्ञानं ज्ञानिना सत्तदर्शिना"
  },
  {
    "start_s": 504.0,
    "end_s": 514.0,
    "ctc": "जज्ञस्या पुनः पुनोहामीवं जास्यपम्"
  },
  {
    "start_s": 510.0,
    "end_s": 520.0,
    "ctc": "पुन पुुनोहमीमं जाच्छतिपाण्डवौ जीनभूतान्नशेनृ"
  },
  {
    "start_s": 516.0,
    "end_s": 526.0,
    "ctc": "गी नो भूतन शीसीनो दृः कश्यात्मन्न तो भुमै"
  },
  {
    "start_s": 522.0,
    "end_s": 532.0,
    "ctc": "अपि चेदसीपापिभ्य सर्विभ्य पापकृत्त्तमं"
  },
  {
    "start_s": 528.0,
    "end_s": 538.0,
    "ctc": "सभ्य सर्विभ्यो पापकृत्तम सर्वं ज्ञानुप्रवीनैव प्रजीनं शंन्तरीर्षसिी"
  },
  {
    "start_s": 534.0,
    "end_s": 544.0,
    "ctc": "प्रजीनं शंतरीशसी यथैधांसी समीभोमि"
  },
  {
    "start_s": 540.0,
    "end_s": 550.0,
    "ctc": "भस्मश्वकृृतीर्जुनौ ग्यणामि सर्वकनुणी भस्मस्ः"
  },
  {
    "start_s": 546.0,
    "end_s": 556.0,
    "ctc": "ज्ञानामी सर्वकनुणी हस््म स्वासुते तथा नहि ज्ञानीनः सदृशम्"
  },
  {
    "start_s": 552.0,
    "end_s": 562.0,
    "ctc": "नहि ज्ञानीनाः सदृशं ववित्तामिह विदति तत्क्षणम्"
  },
  {
    "start_s": 558.0,
    "end_s": 568.0,
    "ctc": "तत्क्षणं जू संंसिद्ध्य कालीनाात्मनि विन्दति"
  },
  {
    "start_s": 564.0,
    "end_s": 574.0,
    "ctc": "सद्यावां लवते ज्ञानं तत्परसते"
  },
  {
    "start_s": 570.0,
    "end_s": 580.0,
    "ctc": "तत्परसंजतीन्द्रियः ज्ञानं लभ्या परं विःश्रान्ति"
  },
  {
    "start_s": 576.0,
    "end_s": 586.0,
    "ctc": "ज्ञानं लभ्या परंः श्रान्तीमचीरेणाधिगच्छतित्"
  },
  {
    "start_s": 582.0,
    "end_s": 592.0,
    "ctc": "अजग्नश्च्याप्रधानश्च संसयात्मान्"
  },
  {
    "start_s": 588.0,
    "end_s": 598.0,
    "ctc": "तत्प्रधानश्च संसयात्महाापनस्तति नायं लोकस्ती न परो न सुखम्"
  },
  {
    "start_s": 594.0,
    "end_s": 604.0,
    "ctc": "नायं लोकस्ती न परो न सुखं संशयात्मन"
  },
  {
    "start_s": 600.0,
    "end_s": 610.0,
    "ctc": "योगौ संमष्टकर्माणं गण सक्षिनम्"
  },
  {
    "start_s": 606.0,
    "end_s": 616.0,
    "ctc": "कर्माणं ज्ञण सच्छिन्नसशयम् आहवन्तङ्नकर्माणि"
  },
  {
    "start_s": 612.0,
    "end_s": 622.0,
    "ctc": "आहवन्तंन कर्माणि निवध्नन्ति धनञ्जय तस्माद््ञान"
  },
  {
    "start_s": 618.0,
    "end_s": 628.0,
    "ctc": "तस्माद््ञान सम्भूतं शिं ज्ञानात्"
  },
  {
    "start_s": 624.0,
    "end_s": 634.0,
    "ctc": "शिं ज्ञानासनात्मना चित्तेन संशयं योगवाप"
  },
  {
    "start_s": 630.0,
    "end_s": 640.0,
    "ctc": "चित्तीनं शशयं यूगमास्तिष्ठोत्तिष्ठ आहरतं"
  },
  {
    "start_s": 636.0,
    "end_s": 646.0,
    "ctc": "तत्र्थ श्रीसमरभगोद्धितासु पुंससु ब्रह्मविदयां जोवशास्त्री श्रीकृष्णाः"
  },
  {
    "start_s": 642.0,
    "end_s": 652.0,
    "ctc": "ब्रह्मविद्यायां जूगशास्त्री श्रीकृष्णार्शुनसंवादी ज्ञानकर्मसन्न्यासजूगनामा चतुस्तवस्थायात्"
  },
  {
    "start_s": 648.0,
    "end_s": 652.7,
    "ctc": "ज्ञानकर्मसन्न्यासजूुनामा चतुस्तवथाया"
  }
]