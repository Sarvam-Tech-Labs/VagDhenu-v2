[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "सञ्चत् श्रीभगवान् वा मय्या सप्तमना पार्थ्य"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "नि्यासप्तमनाापााह्य जूगंझुञन्मदाश्रय"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "श्र असं सयं समग्रं मां जस्यानःशचित"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "यस्यानःस्यचितश्चिनो गणं तीहं"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "ज्ञणं तिहंसमिदं वक्षम्"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "मिदं वक्षांमश सतः जज्ञत्वाे"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "जज्ज्ञत्वा नेव भूयन्न्न ज्ञातव्यामवशीष्यते"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "ज्ञातव्यामवशीष्यते मुमीरापोर्नलो वायु"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "भुमीराापूर्णलोायु क मनो बुधिरेव च"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "बुद्धिरेव च अहंकार इति यन्वे"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "मकार इ यन्वे विन्द्या प्रकृतिरश्चहा"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "अपरीयमितसन्यां प्रकृतिं विद्धिमीपंम्"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "प्रकृतिं वििमीपम् जीवभूतां महाबाहो"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "ैव भूताां महाबाहो जैेदंधारतीजव"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "एताद् योनिनि भूताणि"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "ूनिनि भूतानि सर्वाणि तूपधारय"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "अहं कृष्णश जगतः प्रमवप्रलयस्तथाम्"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "मवप्रलयस्तथा मत्रापर्तनंम्"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "मत्रापरतनं नान्य किञ्चिदसी धनंजय"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "मयि सर्वमिदं प्रूतं"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "मममिमिदं प्रूतं सुत्रे मणीगणा इिव"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "रसोहंप्सुकौ तय प्रभास्मि"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "प्रभास्मिी शशिसूजयो प्रणवशबव"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "प्रणवा सर्ववरेषु शब्दखिपौघृशन् निषु"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "पुण्यगन्या पृथिव्याणः"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "पुण्यगन्या पृथिव्या च तेजस्यास्मि विभावसौ"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "जीवनं सर्वभूतेषु सपश्यामि"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "तेषु तपस्यास्मिितपशिषु बीजङ्मांसरु"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "वीजङ्मां सर्वभूतानां विद्धीपाठशनातन"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "बद्धीपाठर्शनातनम् बुद्धीबुद्धिमतामस्मि"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "ब बुद्धिमतामस्मि तेजस्तेजसनामहं"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "बलं बलवत चाहं"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "ं बलवतां चाहं कामरागविवर्जितम्"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "धर्माविवुद्धो भूतेषु कामम्"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "भूतेषु कामस्मी भतर्सवं"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "जीतैव सारत्तिकाभावा राजशास्तांः"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "राजसास्तामसा सजी मत्त एवे तीताण"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "मत्ता एवेती ताण विद्धि नत्तहं ते सुते मयि"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "त्रिभि गुनमयै भावैरेवि"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "धी गनमयै भावै देेवी सद्मिदं जगत् मोहितं नाभिज"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": "मोहितं नाभिजानाति मामेभ्यो परमभयम्"
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "दैवी य सा गुणमय ममो मोयोम्"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "एषा गुणमयी ममो माय दुरतया मामव हि"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "मामवा हि प्रपदन्ति मायामीतां धरन्ति ते"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "वमीतांर नवाङ् दुष्खितनां मूढा"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "मां दुष्खिजनां मूढा प्रपद्यन्तेनधमाायया"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "वायणपरिहित्याणामासनं भावमा सृति"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "आसुरं भावमास्रितः चतुर्विधा भजन्ते"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "चतुर्विधा भजन्ते मां जनासूितिनोर्जुनान्"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "आतोौ जिज्ञासूरर्थार्थे"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "सूरथार्थ ज्ञनी च भयतनसभ"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "पीषांङ्गाणी मित्तयुक्तंेक भक्तिम्"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "एकभक्ति विशीषते प्रियो हि ज्ञानिना"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "प्रियो ही ज्ञनिना तर्थम् अहं शाच मम प्रियाः"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "उदाारर् सर्वर्वेः"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "उदाराः सर्वैवै त गनीतात्मैव मीम"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "गेनीतात्मैव मीमतम् आसितषहिदुक्तात्माम्"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "आसितर्षहिदुक्तात्मा मामेवानूत्तमागतिम्"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "बहुनां जन्मनामन्ते"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "मानां जन्मनामन्ति ज्ञान्वान् मां प्रबादति"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "वासुदेव सर्वर्वमेति स महात्मा"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "स महात्मा सुदूर्लवौ कामैस्तस्तहितम्"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "कामैस्तैस्तैहिताणा प्रबद्यन्ती न दीवतः"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "तं तं नियममास्थाय प्रसित्यान्यतार्थया"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "ानियटत्मया जूयूयां यांान्तनुं भक्त्याौ"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "पूजूयां यांान्तनुं भव्य श्रद्धयाचितमिच्छति हि"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "तस्य तस्य कषणां सद्यं सामीवो विदधा"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "सामेवो विदधामहं कतया श्रद्धया दुक्तौ"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "स्वतया श्रद्धया दुक्तोस्तस्त ताराधनमे"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "मस्तताराधनमीहति लबते च ततःक्यामान्"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "नच च ततः क्यामान् मयैगोभिधान्हितान्"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "हन्तवत्त्तुफलं तेषम्"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "तद्् भववत्ताल्पमेधशां"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "दीेवानि देव जजूयानि"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "देवानि देव जजूयान्ति मनुुभक्त्या जान्ति मामपि"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "जान्तिमपि अभभक्त्यं भक्तिमापण्यं"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "मभक्त्यं भक्तिमापण्यं मन्नतिमामवोधय"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "परं भावमजानन्तूमाव्य्य"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "मन्तूवमाप्य मनोत्तमम्"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "नाहं प्रकाशसर्वस्रं योग माया समापितः"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "मूलो यं नाभि जानाति लोकोमामर"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "लूको  ममजमम् वीराहं समितताानिि"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "वीराहं समिितीताणि वर्तमानानि चार्जुन"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "भविष्याणी च भूतानि मां तु वेद न कश्चन"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "मांस वेद न कश्चन इच्छाद देशसमुत्थेन"
  },
  {
    "start_s": 425,
    "end_s": 433,
    "ctc": "इच्छादधीशसमुदीन दन्मोहिनाभारत"
  },
  {
    "start_s": 430,
    "end_s": 438,
    "ctc": "भारत सर्वभूतानि संमोहं सर्वर्गे ज"
  },
  {
    "start_s": 435,
    "end_s": 443,
    "ctc": "सर्वर्े जान्ति परं तपम्"
  },
  {
    "start_s": 440,
    "end_s": 448,
    "ctc": "जीसान्तन्तगतं पापं जनानां पुन्नकृम्"
  },
  {
    "start_s": 445,
    "end_s": 453,
    "ctc": "जनाानां पुन्नकर्मणाां तीदं न महुनिं मुक्त्या"
  },
  {
    "start_s": 450,
    "end_s": 458,
    "ctc": "तीदं मुह्निं मुक्त्या भजन्ती मां वििरभ्रतः"
  },
  {
    "start_s": 455,
    "end_s": 463,
    "ctc": "मा जडामरणमुोक्षायो"
  },
  {
    "start_s": 460,
    "end_s": 468,
    "ctc": "मुक्षायो मामासित्वजतन्तिजे ते ब्रह्म तद्भिदु"
  },
  {
    "start_s": 465,
    "end_s": 473,
    "ctc": "ते ब्रह्म तद्भिदुत् कष्णंध्यात्म कर्म चाखिलम्"
  },
  {
    "start_s": 470,
    "end_s": 478,
    "ctc": "अध्यात्म कर्मचाखिलम् सादिभूताादििदैवं मां"
  },
  {
    "start_s": 475,
    "end_s": 483,
    "ctc": "अ भूतधिदैवं मां साधिजं जसेवितु"
  },
  {
    "start_s": 480,
    "end_s": 488,
    "ctc": "प्रयाणकालीपी चमां ते विदु"
  },
  {
    "start_s": 485,
    "end_s": 493,
    "ctc": "च मां तेबदूद्युक्तचेतसा"
  },
  {
    "start_s": 490,
    "end_s": 498,
    "ctc": "ओ त सदृति श्रीमद्भगवद्गीताषु पुंसःसु ब्रह्मविदयांम्"
  },
  {
    "start_s": 495,
    "end_s": 503,
    "ctc": "ब्रह्मविद्यायां जूवशास्त्री श्रीकृष्णार्जुनसंवादीविः"
  }
]