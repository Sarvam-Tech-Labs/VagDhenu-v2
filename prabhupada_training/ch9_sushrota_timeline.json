[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "नैन् च्यााप्टन्ता भगवानुवाच इदं"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "च इदं तु तै गुह्यतमं परमक्ष्याम्योनशू"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "प्रमक्ष्याम्य नसूयव ज्ञानं विज्ञानसहितम्"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "विज्ञानसहितं जज्ञप्या मोक्षसी सुवा"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "अस्सद्दधानां पुरुषांम्"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "धारा पुरुषा धर्मश्यास परन्तपांप्राप"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "अप्रााहां मां निवर्तन्ति मृत्यु शंशारम्"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "मृत्तुशंशार मया ततमिद"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "मया कथमिदं सर्वं जग तद्भक्तमूचिनो"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "भक्तमूचिनां मत्सणि सर्वभूतानि नचाहं"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "मूताणि नचाहं तीेशवस्थितः"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "यथापाशःस्य तु नित्यं वायु सर्वर्वोगतो महान्"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "वायू सर्वर्वगतो महान् तथा सर्वाणि भूतानि वत्थानि"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "मत्सानि तपुधारय सर्वभूतानि कौन्तीय"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "सर्वभूतानि कौन्तीरप्रकृतीं ज्यान्ति मामिकां कल्पक्षये पुनसणि"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "कल्पक्षै पुनः सोणि कल्पादूभिःसृजाममहम्"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "प्रतिदिंशामवस्तभ्य विसृजामि पुनः पुनः"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "विस्र्यामि पुनः पुनः भूतग्राममिवङ् कष्णम"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "मबसं पृथिवीभजा नश माङ् तानि कर्माणि निब"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "नशमाङ् तानि कर्माणि निवदनन्त धनञजया उदासनबदासीन"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "उदासनबदासिन मसत्सङ् तषु कर्मसु मयाधक्षे"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "मयाधक्षेन प्रतितिः सुयते सचराचरम्"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "सतेे सचराचरं एेतुू नानेन कौन्तिय"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "ानेन कौन्तीय जगद्वी परिवाासते"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "अवजानन्ति मानमूढा मानानिवः"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "मानमूढा मानसीं तनुवाासितम् पर"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "परं भावमयाानन्तु ममो भूतमहेश"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "ममो भूतमहीसरं मोघास मोघुकर्माणौ"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "मोघासां मोघकर्माणां मोघगणभिचेत सः"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "तसः राक्षसीमासरिं चैव प्रतितिं मोहिनिं"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "प्रतिभिं मोहिनींसिता महात्मानः सु मां प्र"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "महात्मानस्त मां प्रार्थनं दैवं प्रकृतीमासितः"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "प्रकृतीमसितः भजन्त्य नन्न मनसौ"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "न्द नन्न मनसौ नत्याभूताादमभयम्"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "सततं कैकन्तमां जतन्तस्य दिशम्"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "जतन्तस्य दिडव्रत नमसन्तस्य  महंभक्त"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "नमसन्तश्च महभक्त्या नितजुप्त्या उपासती"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "ुक्त कुपशति ज्ञानजज्ञीना चापन्नेे"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "ेन यजन्तू मामुपासति"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "मामुपासृति एक तेन पिथ्तेन बहुधा"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": "पिथ तेन बहुधाभिि स्यतोमुखम्"
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "अहं कतूरहं ज सदाहोः"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "सदाह महमौशरं मन्त्रूह महमे"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "मन्त्रू ह महमेवज्यां महामग्नेरः"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "महामग्नेरहं हुतं गतिभत्या प्रौष"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "गतीभर्त्या प्रौः शाक्षी निवााससरणं श्रे प्रबवात्"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "प्रबवप्रलयशाणं निधनं गीज"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "निदनंीजमभयं तपहंं"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "तपामहंमहंबर्षं निधन्या मौत्सजामि च"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "आमितं चैव मितुश्च सदसम्"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "स मितुः स सदसच्या अहम"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "त्रैविद्यामाङ् सोमपापुतपापां जज्ञैरिष्ट्या सर्व"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "जज्ञैरिश्च सर्वगतिं प्रार्थयन्ति ते पन्नमाश्या"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "ते पन्नमाश्यादसुरन्दलोकमस्नन्ति दिद्वान्"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "मस्नन्ति दिवां दविधीेवभोगां पीठंभुक्त"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "पीठं भुक्त्या सर्गलोकं विशालं चीने पुन्ने मल"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "चीने पुन्ने म तु लो॒कं विसन्ति एवं त्रै"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "एवं त्रिैधर्म मनुप्रपन्न्या गतगतं काम"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "मान्या गतागतं कामकामा लवन्ति"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "अनन्नश्चिन्तयन्तु मां ये जना पर्युपाासते ती सम्"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "ये जना परयुपाशते तैेषां नित्याभियुक्ताणां जूवच्छीमं वहामहम्"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "जूवच्छीमं वहामहं जिप्वन् दीवता भक्त्या जजन्ति सध्यान्नितः"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "य्या जजन्ति सध्यान्नितः ते पी मामेव कौप्य यजन्त विधिपूर्वकम्"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "अहमे सर्वजज्ञाणां भोक्ता च प्रभुरेव च"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "भोक्ता च प्रभुरेव च न तु मामभिगणन्ति त तै नातश्च मन्ति ते"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "त तेनातश्च मन्ति ते ययान्ति देवभृत नवाान् पितॄीन् यान्ति पितॄन्"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "ैवभ्रत नैवान् पितॄीन् यान्ति पितृभ्रतः भूतानि य"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "यति भूतेत जान्ति मदजजिनो पी माम् पत्रं पुष्पं फलं"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "पत्रं पुष्पं फलं तूयं जूमी भक्त्या प्रयच्छति तदहम्"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "तदहं भक्तुपहिता मस्नामि प्रजतात्मनः"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "स्नामीजत्मः यत् करोषी यदाश्नोसि"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "जज्जुहोसी ददाासिज"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "य तपःस्यसीकौन्तिया तत् कुरुष्यमदर्पणम्"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "सुभासुवफलैरेवोक्षम्"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "सुभासुवफलयिरेवं मूक्षसीकर्मवन्दने सन्न्यास जूगयुक्त्यात्मा"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "सन्न्यास जोगयुक्त्यात्मा विजुक्तो मां कैष्यसि समोहं सर्वभूतेषु"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "समोहं सर्वभूतेषु न मे देश्यसिनाप्रिया ये भजन्ति त मां"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "ये भजन्ति सु मा नुहक्त्यामयि ते पी सुु चापहम्"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "अपी त सुदु्रचार भजते मामनन्नभात् साधुरीव समन्तर"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "य मामनन्वहा साधुरीव समन्तव्या समग् बवसिता ही सा"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "क्षिप्रं भवति धर्मात्मा स सच्छान्ति निगच्छति को नः"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "स स्च्छान्ति निगच्छति कौन्त्यप्रतिज्ञानैः न मे भक्तः प्र नश्यति"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "न मे भक्त प्रनश्यति मां हि पात् विपात्सृत्"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "मां हिपात् विपात्सित्यां जीपी सुभुः पापजूनः"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "सुः पापजूनः स त्रियो वश्यास्तथा शुद्रा सेपीया"
  },
  {
    "start_s": 425,
    "end_s": 433,
    "ctc": "शुद्रा सपीय दीपां गतिं कि पुन ब्राह्मणा"
  },
  {
    "start_s": 430,
    "end_s": 438,
    "ctc": "किङ् पुनाद् ब्राह्मणा पुण्या भक्ता राजषयोःस्तथा"
  },
  {
    "start_s": 435,
    "end_s": 443,
    "ctc": "जषयोस्तथाम् अनित्यमसुखं लूकमिमं प्राप"
  },
  {
    "start_s": 440,
    "end_s": 448,
    "ctc": "विमं प्रापभज समहं मन्मना भवमद्भक्तु"
  },
  {
    "start_s": 445,
    "end_s": 453,
    "ctc": "मन्मना भवमद्भक्तु मदयाजी मांमस्कुरु"
  },
  {
    "start_s": 450,
    "end_s": 458,
    "ctc": "नमस्गुरु मामेवैः ससीदुक्तैवमा तमानानन्दत्"
  },
  {
    "start_s": 455,
    "end_s": 463,
    "ctc": "म वामा तमानानन्दमत््मनााय नः"
  },
  {
    "start_s": 460,
    "end_s": 468,
    "ctc": "ओ तर्थदिति श्रीमद्भगवद्गीतासु पुणसत्सु ब्रह्मभिज्ञायां जूवशार"
  },
  {
    "start_s": 465,
    "end_s": 473,
    "ctc": "ब्रह्मविनायाङ् जूगशास्त्रे श्रीकृष्णार्जुनसंवादे"
  },
  {
    "start_s": 470,
    "end_s": 478,
    "ctc": "ेविद्याराजगह्यधूगुनाम नमोोधय"
  }
]