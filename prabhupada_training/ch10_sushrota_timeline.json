[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "भगवद्गीता केट च्याक् श्रीभगवानुवा"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "भूय एव महाबाहो शृणु मे परमवचः"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "शृणुमि परमवच ज तीहं प्रियमाणाय व्रक्ष्यामिततां मया"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "ितपांया न मे विदुः सुदगणा प्रभं नमहर्म्"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "ु सुतगणा प्रभवषय अदिर्ही देवष"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "अदिर्ही देवानां महर्षीणां च सर्वस"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "जूमामजमनादिं च भत्तीलूपमहेसरं"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "भितत्तीलूपमहीसरं असनमूरसमत्रेषु"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "असनमूरसमत्रेषु सर्वपापै प्रमुच्यते"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "बुद्धिज्ञानमसङ्मोहक्षमासत्तं दमः समा"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "स सुखं दुःखं भो भाभूभम्"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "ुखं भवोभाभूभयङ्क्षाभयमेव च अहिंस्या समता"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "अहिंस्या समुतातुश्चि कपूदानं"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "तपोदानं जसूजसः भवन्ति भामम्"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "भवन्ति भामसूटानां मथैव पृथग््वधम्"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "महर्षौषप्तपूर्वै्च तानुमनवःस्तथाम्"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "पूर्वै चत्रालुमनवःसथा मधुभावा मानुसा जात जीसाङ्ग लूक इमाः पृजः"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "जः तांबिभुतिं जूवं च ममो जू्वत्"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "जूं च ममो जूग्वेत्ति च तत्ततः सो विकम्पेन जोगि"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "सो विकम्पेनाद्योगेन दुजते नात्र संशयः"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "अहं सर्वत्सप्रभवोः"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "मं सर्वसप्रभवोमाप्ताव सर्वं प्रवर्तते"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "इ मत्या भजन्ती मां बूुधाभावम्"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "बूधाभावोषमन्वितः"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "मत्सित्यामद्गतप्राणान् बोधयन्न्तपर"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "बूधयन्त परस्परं कथन्तक्षमां नित्यम्"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "कथन्तक्षमां नित्यं तुष्यन्ती चर्मन्तिष"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "तेषां हुस्य ऋतियुक्ताणां भजताां"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "अं सदुतियुक्ताणां भजतां प्रीतिपूर्वकम्"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "ददामि ये बृद्धिजों तं जीनमाजान्ति ते"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "तैेषामवानुकं प्रार्थ्य महमाम्"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "ामवानुकंप्वार्थो महम्यानयङ् तमः नासयां यत्मभाव"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "नासयां यत्मभावःसूगानदीपेन भासत उजृवासन"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "परं ब्रह्म परं धाम पवित्रं परमभव"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "परधाम पवित्रं परमं भवान् पुरुषान् शाश्वतं दीव्या"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "शाश्वतं दिव्यामादिदेवमजंबभुम् आाहुसारिसयूसरि"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "आहस्त ऋषयौ सर्वि देवऋषी नानदस्तथा असितु"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "देवर्षी नानदस्तथा असि तु देवलभ्यास सायं चैव ब्रवीसि मे"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "सायं चैव ब्रवीमी ते जनमाङ्गवदसीके"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "ितङ्मणमे जनमाङ्गवदुसीकीसभ नहिति भगवनभक्तिं विदुद्दीवान्ानदाम्"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": ""
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "समेवात्नात्माणं भित्थत्तं सुरुषोत्तम भूतभावनभूति स देवदेवज"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "भूतभावनभूति स देवदेव जगत्पते भक्तं मरहस्य"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "भक्तो मर्हस्यशेषेण दिव्या ज्ञातु विभूत्"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "दिव्या ज्ञातु विभूत जाही विवृथुभिील"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "जाभी विवृथुभिीः लोका इमां सं व्यापतिष्ठ"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "इमां सं व्यापतिष्ठसि कथं विद्यामहं"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "कथं विद्यामहं योगीं त्वां सदा परिचिन्तं"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "केषु कसू चभावेश चिन्तोषिी"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "म सूचभावेश चिन्तोषी भगवनयाम्"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "विस्तारीणात्मनो योगं विहूतिं च जनर्जनं"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "म् भूया कथयति्तिर्हि सिन्न तू नास्ति"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "मौ त तिह सिन्नतूनाास्ति मे मृतम्"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "श्रीभगवान् वाात् हन्तुत्तै कुथयिष्यामि दिव्याछाप"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "हन्तत्तै कुथयिष्यामि दिव्याछाप विभूतया प्राधानतः कुरुस्रश्च न"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "प्राधानतः कुरुष्रश्च नास्तं तूभिस्तरश्रमे"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "अहमापमा गुणाकीश सर्वभूताशयस््थितः"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "सर्वभूता हस्थितः अहमादिश्च मद्धं च भूताणामन्द एव च"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "भाम एव च आदैप्ताणामहं विष्णु"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "ष रविडं"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "मर्ची मरतामस्मिनसत्रणामहं शशी"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "णामह बिराणङ्"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "वीराणां सामपिीेदस्मिन् देवानां"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "देवानंसीवासभम् इन्द्रियां मनसस्मि"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "इन्द्रियणां मनस्यास्मि भूतानामसचेदन"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "रुद्राणां संकृषसम्"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "रुद्राणां शङ्कृश्यास्मी वित्तैसम्"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "बृधनां पापुकश्चोस्मिी मेरुशिखणामहं"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "प्रोधसां च मुखं मां बद्धिपातभृ"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "मां बद्धिपतु बृहस्पतिम् सेनानीनाामहंस्कन्ध"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "सेनानीनामहं स्कन्द्यःसरसामस्मिसाावरम्"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "मनसीनां भिगूरहं"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "गीरामस्म्यैकमसरं जज्ञानां जपजुगोस्मि"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "जज्ञानां जबजुगोस्मी सावराणां हिमालयः"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "अश्याख्या सर्वविक्षाणां देवोःषीनां च नारदः"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "बीभोलषीलांक्ष नारदां गन्धर्वाणा चित्ररथ"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "गवााणां चित्ररथो सिद्ध्याणां कपिलो मनी"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "उच्चैः ससमस्यां विद्धिमां न मृतुूद्भवत्"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "धीमांममृतूम् वैरावतं गजेन्द्राणां नराणां"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "ावतं गजेन्द्राणां नराणां च नराधपम् आयुधानामहंबरे"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "आयुधानहजं धेनूनामस्मिकामधू"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "धेनूनामस्मिकामधू प्रजनाश्चाश्वितं नत्य्यम्"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "जनाश्चास््वितं रप्यं सर्पाणामस्मि वाासुकी"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "अनन्तस्याहंनागाणां गुरून्"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "जागृसामहं पितृणामर्जवाश्च"
  },
  {
    "start_s": 425,
    "end_s": 433,
    "ctc": "पितृनामजवाश्चास्मि जमो शंजसंशं जमताः"
  },
  {
    "start_s": 430,
    "end_s": 438,
    "ctc": "प्रल्लादश्चास्मिदै्चणां"
  },
  {
    "start_s": 435,
    "end_s": 443,
    "ctc": "प्रह्लादश्चास्मिदैत्यानां कालुकलयतामहं मृगाणां च मृजन्"
  },
  {
    "start_s": 440,
    "end_s": 448,
    "ctc": "मृगाणां च मृजन्द्रूहं गुैनतेयश्चपक्षिणाम्"
  },
  {
    "start_s": 445,
    "end_s": 453,
    "ctc": "पन पवनपोथामस्मि रामशास्त्रम्"
  },
  {
    "start_s": 450,
    "end_s": 458,
    "ctc": "रामशास्त्रभिताम जितानङ्मकरशस्मि"
  },
  {
    "start_s": 455,
    "end_s": 463,
    "ctc": "जितानङ्मकरश सुतुषामस्मिजान्नवी"
  },
  {
    "start_s": 460,
    "end_s": 468,
    "ctc": "मि सृर्गाणामाभिरन्तश्च"
  },
  {
    "start_s": 465,
    "end_s": 473,
    "ctc": "मणामाभिरन्तस्य मध्यं चैव होमर्जुनं"
  },
  {
    "start_s": 470,
    "end_s": 478,
    "ctc": "अध्यात्मविविद्याणां वादो प्रोः"
  },
  {
    "start_s": 475,
    "end_s": 483,
    "ctc": "मभिद्याणां वादो प्रभो धृतावहम्"
  },
  {
    "start_s": 480,
    "end_s": 488,
    "ctc": "रसराणम्कारो समिी दन्दस्य"
  },
  {
    "start_s": 485,
    "end_s": 493,
    "ctc": "अकारो समिी दन्दसमासिकः स च अहमवाक्षयोूकान्"
  },
  {
    "start_s": 490,
    "end_s": 498,
    "ctc": "अहमवाक्षयो कालधाताहं विस्वसौमुखम्"
  },
  {
    "start_s": 495,
    "end_s": 503,
    "ctc": "मितू सर्वहरस्याः"
  },
  {
    "start_s": 500,
    "end_s": 508,
    "ctc": "मुद्धभश्च भविष्यतां कीर्ती सीमा"
  },
  {
    "start_s": 505,
    "end_s": 513,
    "ctc": "कीर्तीसी वाक्ष नारीणां स्मृतिमेधाधितिक्षम्"
  },
  {
    "start_s": 510,
    "end_s": 518,
    "ctc": "बिहः सामंस्तथा॒ श्यामनंम्"
  },
  {
    "start_s": 515,
    "end_s": 523,
    "ctc": "सामंस्तथा श्याम्न गायत्रीछन्दसामहं"
  },
  {
    "start_s": 520,
    "end_s": 528,
    "ctc": "मासाणामावसिः सोहं मृगते"
  },
  {
    "start_s": 525,
    "end_s": 533,
    "ctc": "सोहं मृगणां कुष्माकरहं दूतं चलम्"
  },
  {
    "start_s": 530,
    "end_s": 538,
    "ctc": "दूतं छलदामस्मीतिज्योतिसस्तिलामहम्"
  },
  {
    "start_s": 535,
    "end_s": 543,
    "ctc": "जयोस्मी व्यवसायोस्मि सत्यं स"
  },
  {
    "start_s": 540,
    "end_s": 548,
    "ctc": "स्मि सत्तं सत्तमताम विशमिणस"
  },
  {
    "start_s": 545,
    "end_s": 553,
    "ctc": "भृष्मििणां वासुजीवस्मि पाण्डवानां धनन्यय"
  },
  {
    "start_s": 550,
    "end_s": 558,
    "ctc": "नय मुनीनाामपहं ग्यास"
  },
  {
    "start_s": 555,
    "end_s": 563,
    "ctc": "मपहं व्यास कवीना ह मुशनााः कवी"
  },
  {
    "start_s": 560,
    "end_s": 568,
    "ctc": "दण्डो दमयतामस्मि नीतीरस्मी"
  },
  {
    "start_s": 565,
    "end_s": 573,
    "ctc": "नीतीरस्मी जिगिसताम् मौनं चैवास्मि गैहाणाम्"
  },
  {
    "start_s": 570,
    "end_s": 578,
    "ctc": "मौनं चैैवस्मि गैहाणां ज्ञानुं ग्यानवतावहं"
  },
  {
    "start_s": 575,
    "end_s": 583,
    "ctc": "यस्यापि सर्वभूताणां बीजं तदहंम्"
  },
  {
    "start_s": 580,
    "end_s": 588,
    "ctc": "वीजं तदहमार्चुनं नातदस्यी विनाजस्यं"
  },
  {
    "start_s": 585,
    "end_s": 593,
    "ctc": "तदस्यी विनाजस्य मया भूतं्छराचरम्"
  },
  {
    "start_s": 590,
    "end_s": 598,
    "ctc": "नान्तू सि मम दिव्याणां विभूतिम्"
  },
  {
    "start_s": 595,
    "end_s": 603,
    "ctc": "मम दिव्याणां विभूतीनां परं तपम् एषातदुद्दिशो"
  },
  {
    "start_s": 600,
    "end_s": 608,
    "ctc": "एषातरु उद्देशता प्रोक्तं विभुते विसरो मया"
  },
  {
    "start_s": 605,
    "end_s": 613,
    "ctc": "विभुते विसरूमयां जद््जद् विभृधीमत् सत्यं"
  },
  {
    "start_s": 610,
    "end_s": 618,
    "ctc": "जज्जद् विभुधीमत् सत्यं सिमादूर्जितमेवान्"
  },
  {
    "start_s": 615,
    "end_s": 623,
    "ctc": "तत्र प वाभगच्छत्य्यं ममो तेजां ससम्भवम्"
  },
  {
    "start_s": 620,
    "end_s": 628,
    "ctc": "तजांश अथवा बहुनै तेन कि"
  },
  {
    "start_s": 625,
    "end_s": 633,
    "ctc": "बहु नै तेन किङ्ग तेन तमाहासन विस्त्रभ्याहमिदम्"
  },
  {
    "start_s": 630,
    "end_s": 638,
    "ctc": "विणृभ्याहमिदं कृष्णंमीकांसीनं सितूजग"
  },
  {
    "start_s": 635,
    "end_s": 643,
    "ctc": "ओ तर्सदितीस््मन्भगवद्गतासु पुंसम्"
  },
  {
    "start_s": 640,
    "end_s": 648,
    "ctc": "ी समद्भगवद्गितशुुशस्रु ब्रह्मविदयां योगशास्त्री श्रीकृष्णार्जुन"
  },
  {
    "start_s": 645,
    "end_s": 653,
    "ctc": "ायोगशास्त्री श्रीकृष्णार्जुनसवादेनाम दशमध्याय"
  }
]