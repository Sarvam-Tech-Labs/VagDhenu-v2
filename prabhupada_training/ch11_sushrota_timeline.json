[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "भगवद्गीता एकादशद्ध निलयंित अर्जुनवात्"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "अर्जुनव मदनुक्रहाय परमं गुहय"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "गुह्या मुध्यांमसङ्गितं ज त्वयोक्तं बच"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "जत् त्वयोक्तं वचसेन मोहो यं ग त मम"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "मवाप् पयो हि भूताणां श्रुतो विस्त"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "य हि भूताणां श्रुतौ विस्तरुषो मया"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "दत्य कमलपत्राक्ष्य माहात्ममपि चम्बयं"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "मन्नसे यदि तच्छक्यं मयाादस्यते"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "यदि तथक्यं मया दस्त्वम् इति प्रभो जोगिः सर्वू ततः"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "योगिः सर्वोततोू मित्यं दर्शयात्मा"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "त् नमोभयं इति भगवान्"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "पशमे पातरूपाणि स तुसूथा महासहस्रतः"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "तुसूथा महासहस्रतःः नानाविधानि दिव्याणि नानावन्याकृतानि च"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "ण नानावन्याकृतानि च पश्यादि"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "पश्यादित्यां ुद्यानः सिनोम् मर"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "ऋद्यानः सिनों मरितस्तथा बहुन्या दृष्टपुर्वाणि"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "बहुन्या दृष्टपुर्वाणि पशास्यर्याणि भारतौ"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "इहैकः सज्जगत् कष्णं पश्याद्ःसच्छराः"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "व कष्णं पश्याद्सराचरं ममो धीः गुराकीश"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "मो भीः गुराकी स जचान्या द्रष्टुमिच्छसि"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "नतुु मां सःकसीदश्रूमनेयेते"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "ं सप्रसीदस्रूमनेनैव सचकुष सिबं ददामि ते"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "सिबं ददामि ते चक्षूपश्रमे जोगमैश्वरं"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "संन्निर्वाात् एवमुक्ता चतूराम्"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "एवमुक्ता ततूराजन् महाजूविः सरोरी दर्शयामासपात्"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "दर्शयामास पार्थाय परमङ् रूपमैसरं"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "अनेकभक्तं नयनमनेकादभुतदर्शनं"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "ाद्भुतदर्शनम्नेकभरणं दिव्यानैको"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "दाम् दिव्या नैकूर्दताायुधम्"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "दिमाल्यां वररदन्ध्यानले"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "दिपदं ध्यानलेपणं सर्वाश्चजमयं देवम्"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "सर्वाश्चद्यमयं दैवमनन्तं वि सदूमुखं"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "दवीषृर्जसहस्रस्यां भवे"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "सस्य भवे द्यूगोपदृत्तथां जदिभ्यास"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "जदिभ्यासदृशीष्यास्य्य भाशस्तःशमात्"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "वाशस्तस्य महात्म तत्रैकस्थं जगस्"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "तत्रैकस्थं जगस्कृष्णं स विविक्तामनेकध"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "अपश्याद् देवदेवः स शरीरीपाण्डव"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "देवदेवः स सरीधी पाण्डवः सदा ततः सभिविष्ट"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "ततः सभिस््याविट हरिष्णुरूमाधनञजयौ प्ररम्मस्य"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": "धनञय प्रनम्मस्यृषोभिस्तञ्जलिरभासत"
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "ासतजनुवाात् पश्यामि देवांस्तवति"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "पश्यामि देवांस्तव देवदेहे सर्वांस्तथाापूतविषे"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "ांस्तथाापूतविशेषस ब्रह्माणमीशंकमल"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "ब्रह्मणमीशंकमलासनस्य मृसिञ्च सर्वानृगाः"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "मृसिं च सर्वानृृगांश्च दिव्यान् अनेकबाहू"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "अनेकबाहूदरवक्तनेत्रं पश्यामि तां स"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "पश्यामि तां सर्वतनन्तरूपं नान्तं नम"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "नान्तंन मध्यङ्न पुनस्तवादिं पस्यामिपि"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "मं वस्यामिभिशेषरवीशरूप"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "लीदिनं गर्दिनं चकिणं शं तीजडासिंस"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "तीजडासिं सर्वसूदीप्तमन्तं पश्यामि तम्"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "पश्यामि तां दूर्निरीक्षं समन्त्या"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "न्त दित्यानलाकदृध समप्रम मे"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "मेय तमक्षरं पारमं"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "तमक्षरं पारमं भेदितव्यं तमः शविःश्य शापरम्"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "तमःशविश्यशापरं निधानं तमह्वया"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "तमभया सासृतधर्मगोक्तासनातनस्तम्"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "गोक्तासनातनस्तं पुरुषूमतो मे"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "अनादिमध्यान्तमनन्तवीरं"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "मनन्तमाहुंशशसूजनेत्रं"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "सने पश्यामि तङ् दीप्तहुतासवक्तं"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "्तहुता सुवत्रं स तेजसाभिः समिदं तपस्तम्"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "द्यावापृतिभूरिदं"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "द्यावापृतिभोरिदमन्तरण हि व्याप्तं त्वयैकेन दिश"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "व्याप्तं तुयैकेन दिशश्च सर्व दिष्टाभुतं रूपमुग"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "निष्टााधुतं रूपमुग्रं तवेदं लोकत्रं प्रभा"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "लूकत्रं प्रभवथितं महात्मन्"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "अमेहिकां सुर॑स गाव॑शन्ति"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "ि केचिद् वििता प्रञजलयो गृणन्ति"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "सस्ती तुक्त्यां महर्षिसिद्धति"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "तीर्तुक्त्यां महर्षिसिद्धसङ्घ सुवन्त तां्तूतिपुस्कलाः"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "न्तितांस्तूतिपुस्कल रुद्रादित्याव"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "रुद्रादित्यामसभूजितसाद्यां विस्येः सिनौमो"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "विस्यि सनौ मोर्तश्चूक्ष्मपाशं वन्दव"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "गन्दवजक ससिद्धसङ्घा भक्षन्ति तां"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "मा भिक्षन्ति तां भीस्मिताश्चैव सर्वे"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "रूपं महह ते बहुवक्तनेत्रं महाबाहोः"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "महाबाहोबाहूरपादंदर"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "ं बहुदबहुदंःकरालं दृष्ट्या लोकापृभत्"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "दृष्ट्या लूपाप्रबृत्तिताः सथाहं"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "नभः पसङ्गदीप्यमनीकवर्ण्यं व्याप्यान"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "कवर्ण्यं व्याप्याननं दीप्तविशालनेत्रं दृष्ट्याहिताङ्गसभते"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "दृष्ट्याहितामप्रवथितां दुरात्मा दितिं न विन्दामि समं च विष्ण्वु"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "दितिंनविन्दानि समं च विष्णु दंष्टाकरालणि चतीमुखानि"
  },
  {
    "start_s": 425,
    "end_s": 433,
    "ctc": "दनुष्टाकरालानि चतीमुखानि दृष्टैव कालान् लसन्निभाणि"
  },
  {
    "start_s": 430,
    "end_s": 438,
    "ctc": "लसन्निभाणि दीशूनु ज्ञानेन लभे च सर्वप्रसीददेवी स च"
  },
  {
    "start_s": 435,
    "end_s": 443,
    "ctc": "प्रसीदेवीस जगन्निवास अ"
  },
  {
    "start_s": 440,
    "end_s": 448,
    "ctc": "अमीचतामधिष्टराष्ट्र सपुत्रौ सहैव मुनिपालसङ्गै"
  },
  {
    "start_s": 445,
    "end_s": 453,
    "ctc": "नबुनिपालसङ्गै भीष्मध्रूरसूत पुुत्रस्तथासौ"
  },
  {
    "start_s": 450,
    "end_s": 458,
    "ctc": "म पुत्रः सथासौ सहासमदीजैरभिजोदमुखै"
  },
  {
    "start_s": 455,
    "end_s": 463,
    "ctc": "वस्रणि ते तर॑माणाभिशन्ति संंश"
  },
  {
    "start_s": 460,
    "end_s": 468,
    "ctc": "गाणाभिषन्ति दंस्राकरालानि भयानकानि"
  },
  {
    "start_s": 465,
    "end_s": 473,
    "ctc": "केचिद्व विलग्नदशनान्तरेषूषं दृशम्"
  },
  {
    "start_s": 470,
    "end_s": 478,
    "ctc": "मान्तरेषुषन्धिः सन्तिणितैरुत्तमाङ्गैः"
  }
]