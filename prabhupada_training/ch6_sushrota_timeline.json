[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "श्रीभगवानुवाच अनाश्रितकर्ण"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "अनास्थ्रितकर्मफलं कार्यं कर्व करोति च स सन्न्यासी"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "स सन्न्यासी जोगी च न निरनी न चााप"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "चाप जसन्न्यासमि इति पाहुोगः"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "सन्न्यासमिति पाहूजूवङ् तमविद्धिपाण्डव नसं नष्ट"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "न जसंन्नष्ट्य सङ्कल्पो योगी भवति कश्चन आरुरृक्षमुनिित"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "आरुरृक्षमुनिजूगं कर्म कणमुच्यते जूवारुर सतः"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "जुवारुुरः स तस्यैव सम कारणमुच्यते"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "जगाहीनिन्द्रियार्थेषूर्णकर्माम्"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "निन्द्रियार्थी शूर्नकन्मा संसज्ते सर्वसकल"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "सर्वसंकल्पसन्न्यासी योगारूरः सदोचते"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "योगारूरः सदोचते उऊर्द्धरे तत्मनात्मा"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "ऊर्धरे तात्ना नत्मानमवशगय"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "ानमवशादये आत्मीयोचात््मनो बन्धु"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "यधात्मनो बन्धुरात््मैव रिपुरात्मनः"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "बन्धुरात्मात्म न"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "स्तस तस्य्य जीनात्मवात्मना"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "जीनात्मवात्मनाजितः अनात्मनः सूषत्सु"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "अनात्मनस्तूषसुत्ते भर्तिितत्मै सत्त"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "भस्तीतत्मै सत्त जीतात्मना प्रशान्तःस"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "सीतात्मना प्रशान्तः स परमात्म समाहितः"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "ितः श्रीतोष्ण सुखदुःखेषु तथा मानाः"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "तथा मानापमानानय"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "ज्ञानविज्ञचिप्त्यात्मा कुतत् सो विदितन्न्द्रियः"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "कुथत् सो विदितन्न्द्रियः दुक्ताय्तोचति योगी"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "इ्तोचति योगी समलुष्ट्राश्मकान्ञ्चनम्"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "सुविन्मित्रा जुदास्"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "मितर्जुदासीनो मध्यस्य्याद् देशबन्धुषु"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "देशबन्धुषु सारुः सपिी च पापेषु समोबुद्धि"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "म पापेषु शमबुद्धीभिशीष्यते"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "योगी जिनीतस्य तत मात्मानं रहसिः स्थितः"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "रहसि स्थिता एकाापी जतचित्यात्मा निरासीत्"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "निरासीरापग्रहा शूचौ द सि प्रतिष्ठः"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "शूचौ देह प्रतिष्ठप्य श्रीरमा सनवत्मनः"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "वीरमा सनवात््मनः न तुचीतं नातिमीचं"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "त सुुच्छीतं नातिनीचम् चीलजीनोकुशतरम्"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "तत्रैकाग्रं मनकृत्ना यथचित् तेन्द्रियप्रणम्"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "यथचित् तेन्द्रियक्रिय उपविश्यासने धुं"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "य्यासने धन्द्य योगमात्म विसुद्धये"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "समं काय सवो द्रीवं धारन्नचनं सिरा"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": "धारन्नचनं सरा सम्प्रीक्षणासिकाग्रंशं"
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "नासिकाग्रंशं दिसह्यानवलोकयन्"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "प्रशान्तात्मा विगतोभिः"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "प्रशान्तात्मा विगतोभी ब्रह्मचारिभ्रते स्थितः"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "मनःसंयं मम चिद्ध्वो युक्तयासीतमः परः"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "ओजुक्तयासीतमः परम् जुञ्न्ेवं सदाात्माणम्"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "अन्यन्नेवं सदात्मानं जोगी नियतमानसः"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "ानसः शान्तीने द्वाण परमा"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "मत्सानं म निगच्छति ना्ता स्मृतः सु"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "न्ता स्मृतः सुजोवः सी नचैकान्तमसर्मनमता"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "र्म नचापि सप्नशीलस्यां"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "सप्नशीलस्यां जागृतो नैव चार्जनम्"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "युक्ताहारविहारस्य जोगचेष्ट च"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "योगचेष्ट्यात् स कर्मशु युक्त"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "युक्ता सप्नावबोधस्य जोग भवति दुःखः"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "जूव भवती दुःखः जदापि नियतंञ्चित् मात्र"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "ापि नियतंञ्चिच्चमाम आत्म तपन्नैैवावतिष्ठ त"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "तिष्ठ निष्प्रियः सर्वकामेभ्यो जुक्तयुत्युचते"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "जुक्त इितुच्य त यथा दीपनिवातस्य"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "यथा दीपनिवाक सो लिङ्गतीशूपमास्मिता"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "योगिना जतचित्तस्य जिञ्जसू॒ योगमम्"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "ितस्य जिञसूजुगुमात्मन जत्रूपोरमते"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "जत्रूपोरमस चित्तं निरृध्यं जुवसीवया"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "धं जुवसीवया जत्रोचैवात्मनात्मानं पश्य"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "आत्मनात्माम् पश्यन्नात्मनि तु सति"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "सुखुमात्तन्तिकं यस्य बुद्धि ग्राह्यामतिंते"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "ग्राह्यामतिन्द्रियं भीत्तिजत्र न चैवायं सितः"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "नचैवायं स्थितश्चलति तत्ततः जङ्लब्ध्या चापंङ्ग"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "जङ् लब्ध्या चापुरङ् लाभं मती नादिकं ततः"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "यस्मिन् सीतो न दुःखेन गुरुन्यापीत्"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "गुरुन्यापि विचालते तन् विद्या दुःखसङ्ग"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "तन् विद्या दुःखसंोग वि्योगं जोगसङ्गितं"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "जौवसङ्गितम् स निश्चायेन जोक्तभ्यो"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "यूक्तो योगनिर्धीन्याचतसम्"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "सङ्कल्पप्रोहान् काामान् सक्त्याः सर्वानसी सतः"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "सक्त्याः सर्वानसी सतः मनःशैवन्द्रियग्रामं विने"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "त दैवेन्द्रियग्रामं विनेयम्य समन्तथा"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "सै सवै परमेबुद्ध्या द्वित गृहे"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "निबुद्ध्या द्विती गृहीतयाम् आत्मोशंस्य"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "आत्म शंस्य मनःकृत्या न किञ्चिदपि चिन्ते"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "न किञ्चिदपि चिन्ते यतो यतो निश्चरसी मनः"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "श्चञ्चलामथिरं तथा स तु"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "तथा स तु नममेतमात्मन्ेवोपसन्ने"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "त्मन्नैवापस प्रशान्तमनसंङ्गीनं जूग"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "ान्तमनसंलीनं जूहनं सुखमुूत्तरम् उपैती शङ्करजसं"
  },
  {
    "start_s": 425,
    "end_s": 433,
    "ctc": "उपैतीशाकरजसं ब्रह्मभूतमकल्मसं"
  },
  {
    "start_s": 430,
    "end_s": 438,
    "ctc": "जिञ्जन्मेवं सदात्मानं जोधभिम्"
  },
  {
    "start_s": 435,
    "end_s": 443,
    "ctc": "एवं सदात्मान जोगी विगतकर्मशः सुखेन ब्रह्मस"
  },
  {
    "start_s": 440,
    "end_s": 448,
    "ctc": "सुखेन ब्रह्मसंस्पर्श्य मत्तन्तां सुखमास्मृते"
  },
  {
    "start_s": 445,
    "end_s": 453,
    "ctc": "स्तन्तां सुकमास्मृते सबभूतस्यमापमानं"
  },
  {
    "start_s": 450,
    "end_s": 458,
    "ctc": "ूत समात्मानं सर्वभूतानि चात्मने ईक्षते"
  },
  {
    "start_s": 455,
    "end_s": 463,
    "ctc": "ईक्षते जोगजुक्तात्म सर्वत्र समदर्शनम्"
  },
  {
    "start_s": 460,
    "end_s": 468,
    "ctc": "सर्वत्र समदर्शनम् जूमा पश्यति सर्वत्र"
  },
  {
    "start_s": 465,
    "end_s": 473,
    "ctc": "माम पश्यति सर्वत्र सर्वं च मैि पश्यति"
  },
  {
    "start_s": 470,
    "end_s": 478,
    "ctc": "तस्याहं नापनश्यामि सचामेनापनः सति"
  },
  {
    "start_s": 475,
    "end_s": 483,
    "ctc": "ाप सर्वभूतसितां यूमां"
  },
  {
    "start_s": 480,
    "end_s": 488,
    "ctc": "भूतसितां यूमां भजत्सीकत्म सापतां"
  },
  {
    "start_s": 485,
    "end_s": 493,
    "ctc": "सतिितम् सर्वता वर्तमानो पी स योगीमैवचति"
  },
  {
    "start_s": 490,
    "end_s": 498,
    "ctc": "मवाच आत्मोपंमेन सर्वत्रं संपः शरी"
  },
  {
    "start_s": 495,
    "end_s": 503,
    "ctc": "समंपःशरीरूजुनौ सुखं वा यदि वा दुःखं सजु"
  },
  {
    "start_s": 500,
    "end_s": 508,
    "ctc": "बवजदिव दुःखं सजोगी परमोमत"
  },
  {
    "start_s": 505,
    "end_s": 513,
    "ctc": "जूयां योगस्त्वया प्रूक्तः"
  },
  {
    "start_s": 510,
    "end_s": 518,
    "ctc": "योगस्त्वया प्रोक्त्य श्याम्य न मधुसूदन एत श्यां न पश्याम"
  },
  {
    "start_s": 515,
    "end_s": 523,
    "ctc": "ईतष्यां न पश्यामि चञ्चलत्ता स्थितें स्थिरा"
  },
  {
    "start_s": 520,
    "end_s": 528,
    "ctc": "चञ्चलं हि मनः कृष्णप्रमाथी बलवद्गृहं तश्याहं निितम्"
  },
  {
    "start_s": 525,
    "end_s": 533,
    "ctc": "मीबलवधृहम् तस्याहङ्निद् गहङ् मन्नि वायुरव सुदुष्करं"
  },
  {
    "start_s": 530,
    "end_s": 538,
    "ctc": "श्रिभगवान्वच अहंशन् महाबाहो मनोबुद्धिनिग्ः"
  },
  {
    "start_s": 535,
    "end_s": 543,
    "ctc": "अहंसण महाबाहो मनोबुद्धिनिग्रहक्षलम् अभ्यासीन सुकौन्तियु"
  },
  {
    "start_s": 540,
    "end_s": 548,
    "ctc": "अभ्यासीेन सुकौन्तियबैरागेन च ग्रीयते असंसया"
  },
  {
    "start_s": 545,
    "end_s": 553,
    "ctc": "अस असङ्सयत्त तमना योगी दिर्दिप्राप्य"
  },
  {
    "start_s": 550,
    "end_s": 558,
    "ctc": "जुर्दुप्राप्य इति मीमस पश्यामि"
  },
  {
    "start_s": 555,
    "end_s": 563,
    "ctc": "पश्यात्मना तुजतता सः को वाातुमुपायतः"
  },
  {
    "start_s": 560,
    "end_s": 568,
    "ctc": "अ को वातुमुपायत"
  },
  {
    "start_s": 565,
    "end_s": 573,
    "ctc": "आजति श्रद्धयो पीता जूगच्चलितमानसा"
  },
  {
    "start_s": 570,
    "end_s": 578,
    "ctc": "जूवच्चलितमानसाप्रापजूवसंसिद्धिं कां गतीं कृष्णगच्छति"
  },
  {
    "start_s": 575,
    "end_s": 583,
    "ctc": "कां गतीं कृष्णगच्छति क्वचिन्नोभयम विभ्रष्ट चछिन्नमभ्राम"
  },
  {
    "start_s": 580,
    "end_s": 588,
    "ctc": "व विभ्रष्टछिन्नमभ्रामिव न सतिप्रतिष्ठो महाबाहः"
  },
  {
    "start_s": 585,
    "end_s": 593,
    "ctc": "आप्रतिष्ठो महाबाहो विमूलब्रह्मणोपति एतन्मे संशयं कृष्ण"
  },
  {
    "start_s": 590,
    "end_s": 598,
    "ctc": "एतन्मे संशयं कृष्णा्च्छेत्तुं मरहस्यशीषता"
  },
  {
    "start_s": 595,
    "end_s": 603,
    "ctc": "तदनान् संशयः शास्त्रसीत्यानां ज्युपपदते"
  },
  {
    "start_s": 600,
    "end_s": 608,
    "ctc": "ान जुपपदते श्रिभगवगवथ पार्थ नैवीहनामुत्र"
  },
  {
    "start_s": 605,
    "end_s": 613,
    "ctc": "पार्थ नैवीहनामत्र विनाशस्त सुु विद्यस नहि कल्याणकेत्"
  },
  {
    "start_s": 610,
    "end_s": 618,
    "ctc": "नहि कल्याणकेत् कश्चिद् दुर्गतें ताप गच्छति प्राप्वपन्नःकृतम्"
  },
  {
    "start_s": 615,
    "end_s": 623,
    "ctc": "ताप गच्छति प्राप्वपन्नकृताान् लोकाननूषित्या शाासती मृसमा"
  },
  {
    "start_s": 620,
    "end_s": 628,
    "ctc": "इत्याशासती शुचिनां सिमताङ्गैर् योगभ्रष्टविजायते"
  },
  {
    "start_s": 625,
    "end_s": 633,
    "ctc": "अथवा योगिनामेव  कुली भवति धीमताम्"
  },
  {
    "start_s": 630,
    "end_s": 638,
    "ctc": "तामेव फुली भवति धीमताम् एतद्द्धीदुर्लभतरं लोके जन्मजदििदिशम्"
  },
  {
    "start_s": 635,
    "end_s": 643,
    "ctc": "तत्तोत्तंबुद्धिसञ्जूगं लवते पोपुदेहिकम्"
  },
  {
    "start_s": 640,
    "end_s": 648,
    "ctc": "य लवते पोपदेहिकं जगति च ततो भूय संसिद्धौ कुरुनन्नन"
  },
  {
    "start_s": 645,
    "end_s": 653,
    "ctc": "कुदाभ्यासेन तेनैव ह्रियते"
  },
  {
    "start_s": 650,
    "end_s": 658,
    "ctc": "ेनैव हरियते जबसोपिशा जिज्ञासुरभिजूग स"
  },
  {
    "start_s": 655,
    "end_s": 663,
    "ctc": "जिज्ञासूुरभिजूवः स प्रजत्नाजतमानःसु"
  },
  {
    "start_s": 660,
    "end_s": 668,
    "ctc": "जतमानःसु जोगी संसिद्धमानं किल्मिषौ"
  },
  {
    "start_s": 665,
    "end_s": 673,
    "ctc": "किलमिष अनेका जन्मसंसिद्ध्या स तूजति"
  },
  {
    "start_s": 670,
    "end_s": 678,
    "ctc": "सिद्ध्या सतुूजारतीपङ्गतिं तपः सभोः"
  },
  {
    "start_s": 675,
    "end_s": 683,
    "ctc": "तपसििभो विगो जो गी ज्ञैनिभोपिि"
  },
  {
    "start_s": 680,
    "end_s": 688,
    "ctc": "ज्ञनिभ्यो पि मतो धिका कन्मििभ्योश्चाधिको"
  },
  {
    "start_s": 685,
    "end_s": 693,
    "ctc": "कन्मििभ्योश्चाधिको जोगी तस्माद्जोगी भाह"
  },
  {
    "start_s": 690,
    "end_s": 698,
    "ctc": "ोगीभर्जुन योगिनामपि सर्वेष"
  },
  {
    "start_s": 695,
    "end_s": 703,
    "ctc": "योगिनामपि सर्वेष मद्गतनामान्तनात्मनाम्"
  },
  {
    "start_s": 700,
    "end_s": 708,
    "ctc": "तेनान्तनात्मना सद्ध्यावान् भजती जूमां"
  },
  {
    "start_s": 705,
    "end_s": 713,
    "ctc": "ं भजति जू समीयुक्तम हओमतासदिति"
  },
  {
    "start_s": 710,
    "end_s": 718,
    "ctc": "ओ तासिदिति भगवद्गीतासूपनिषःसु ब्रह्मविद्यायाांम्"
  },
  {
    "start_s": 715,
    "end_s": 723,
    "ctc": "ूपपनिषसु ब्रह्मविद्यायां जूगशास्त्री श्रीकृष्णार्जुनसंहवादे"
  }
]