[
  {
    "start_s": 0,
    "end_s": 8,
    "ctc": "इति स्यात्र्जुनव च किं तद् ब्रह्म"
  },
  {
    "start_s": 5,
    "end_s": 13,
    "ctc": "किं तद् ब्रह्म किमध्यात्मं किं कान्म पुरुषौ तमधीभूताां च"
  },
  {
    "start_s": 10,
    "end_s": 18,
    "ctc": "ूत अधीभूतां च किं प्रोक्तामधीदैवां किमुच्यते"
  },
  {
    "start_s": 15,
    "end_s": 23,
    "ctc": "अधिजज्ञा कथं कूत्र दीहे समिन् मधुसूदना"
  },
  {
    "start_s": 20,
    "end_s": 28,
    "ctc": "देहेस्मिन् मधुसूदना प्रयाणकाले च कथं ज्ञेयोषि नियतात्मभिः"
  },
  {
    "start_s": 25,
    "end_s": 33,
    "ctc": "त्मभि श्रीभगवान वार असरं ब्रह्म परम"
  },
  {
    "start_s": 30,
    "end_s": 38,
    "ctc": "आक्षरं ब्रह्म परमं स्वभावोध्यात्ममुच्यते"
  },
  {
    "start_s": 35,
    "end_s": 43,
    "ctc": "भूतोभावोद्भो करो विसर्ग कर्मशङ्गितः"
  },
  {
    "start_s": 40,
    "end_s": 48,
    "ctc": "शङ्गितः अधीभूतं क्षरोभाव पुरुषाश्चाधीदैवतम्"
  },
  {
    "start_s": 45,
    "end_s": 53,
    "ctc": "पुरुषाश्चाधीदैवतम् अधिजग्य अहमेवत्र देहिभिह"
  },
  {
    "start_s": 50,
    "end_s": 58,
    "ctc": "अहमेवत्र देह देहभिदानवर अन्तके"
  },
  {
    "start_s": 55,
    "end_s": 63,
    "ctc": "अन्तकाले च मामेव स्मरन्मुुक्त्या कलेवरम्"
  },
  {
    "start_s": 60,
    "end_s": 68,
    "ctc": "जप्रयाति समद्भावं जातीनास्त"
  },
  {
    "start_s": 65,
    "end_s": 73,
    "ctc": "मभावं जातीनास्तत्र संशय न्यजनवाप"
  },
  {
    "start_s": 70,
    "end_s": 78,
    "ctc": "न्यञज्यनवापी स्मरनुभावं तजत्तन्ति कले"
  },
  {
    "start_s": 75,
    "end_s": 83,
    "ctc": "तजत्तन्ति कलवरम् यं तमवैदिकौ तीय"
  },
  {
    "start_s": 80,
    "end_s": 88,
    "ctc": "तं तम वैद कौन्तय सदातदभावभावितः"
  },
  {
    "start_s": 85,
    "end_s": 93,
    "ctc": "तस्मात् सर्वेषु कालेषु"
  },
  {
    "start_s": 90,
    "end_s": 98,
    "ctc": "तस्मात् सर्वेषु कालेषु मांमनुू स्मरजुद्दश"
  },
  {
    "start_s": 95,
    "end_s": 103,
    "ctc": "मयार्पितो मनोबुद्धिमामेवै"
  },
  {
    "start_s": 100,
    "end_s": 108,
    "ctc": "मबुद्धिी मामेवै सस संसय"
  },
  {
    "start_s": 105,
    "end_s": 113,
    "ctc": "अभ्यासयोगयुक्तेन चेतसाानानुगाः"
  },
  {
    "start_s": 110,
    "end_s": 118,
    "ctc": "चेतसानानुगामनाां परमं पुरुषं दीव्यं य"
  },
  {
    "start_s": 115,
    "end_s": 123,
    "ctc": "म पुरुषं दीव्यं यातिीपोर्था नचिटयम्"
  },
  {
    "start_s": 120,
    "end_s": 128,
    "ctc": "न्तयं कविं पुराणा मनुषासितारौ"
  },
  {
    "start_s": 125,
    "end_s": 133,
    "ctc": "पुराणाः मनुशासितारौ मनोर्णीयो"
  },
  {
    "start_s": 130,
    "end_s": 138,
    "ctc": "समनू स्मरे॒ सर्वधः"
  },
  {
    "start_s": 135,
    "end_s": 143,
    "ctc": "सर्वसधाताारामचिन्तरूपमा"
  },
  {
    "start_s": 140,
    "end_s": 148,
    "ctc": "सचिन्तरूपमाधीत्तवर्णं तमसः परस्यात्"
  },
  {
    "start_s": 145,
    "end_s": 153,
    "ctc": "प्रयाणकाली मनसाचलीनां भक्तिम्"
  },
  {
    "start_s": 150,
    "end_s": 158,
    "ctc": "मी मनसाचलेनां भक्त्या यु तुजूगबलीन चैव"
  },
  {
    "start_s": 155,
    "end_s": 163,
    "ctc": "ैव भुभोर्मध्ये प्राणमावेश सम्यक्त"
  },
  {
    "start_s": 160,
    "end_s": 168,
    "ctc": "स्य सतं परं पू समुपै दिव्यम्"
  },
  {
    "start_s": 165,
    "end_s": 173,
    "ctc": "यदक्षरं व॒ेदविदो वद॑न्ति विसन्ति"
  },
  {
    "start_s": 170,
    "end_s": 178,
    "ctc": "विसन्ति यद्य तयो वितरा"
  },
  {
    "start_s": 175,
    "end_s": 183,
    "ctc": "यदिच्छन्त ब्रह्मचरं चरन्ति"
  },
  {
    "start_s": 180,
    "end_s": 188,
    "ctc": "न्ति ब्रह्मचर्यं चरन्ति तस्यै पदंशं गृहिणापवक्ष"
  },
  {
    "start_s": 185,
    "end_s": 193,
    "ctc": "गहिणापुरवक्षे सर्वदाराण शयम्य"
  },
  {
    "start_s": 190,
    "end_s": 198,
    "ctc": "संयम्य मनोरिधी निरुद्ध च मूर्ध्ार"
  },
  {
    "start_s": 195,
    "end_s": 203,
    "ctc": "मूर्ध्नधायात्मनप्राणो मा स्थितु यूगधारम्"
  },
  {
    "start_s": 200,
    "end_s": 208,
    "ctc": "माथितु योगधारम्मितीक्षकापनं"
  },
  {
    "start_s": 205,
    "end_s": 213,
    "ctc": "ब्रह्म बहन्मामनुस्मरन् जप्रयाति"
  },
  {
    "start_s": 210,
    "end_s": 218,
    "ctc": "जप्रयाति तजन् देहं सृजाति पमाङ्गते"
  },
  {
    "start_s": 215,
    "end_s": 223,
    "ctc": "हनन्नचीतासततं जू ं सस्मते"
  },
  {
    "start_s": 220,
    "end_s": 228,
    "ctc": "ततञु मां स्मरती नितस तस्माहं कस्याहं"
  },
  {
    "start_s": 225,
    "end_s": 233,
    "ctc": "तस्माहं तस्याहं सर्ववप्रार्थ्यं नितजुक्तस्य योगिनःम्"
  },
  {
    "start_s": 230,
    "end_s": 238,
    "ctc": "नितजुक्तस्य योगिनह मामुप पुनर्जन्म"
  },
  {
    "start_s": 235,
    "end_s": 243,
    "ctc": "दुःखालवसाासतं नाप्नुवन्ति महात्मान"
  },
  {
    "start_s": 240,
    "end_s": 248,
    "ctc": "नाप्नुवन्ति महात्मानः संसिद्धीं परमा गतः"
  },
  {
    "start_s": 245,
    "end_s": 253,
    "ctc": "आ ब्रह्मभुवनोल्लोकं पुनरापत्तिं प्रते"
  },
  {
    "start_s": 250,
    "end_s": 258,
    "ctc": "आललोकं पुनराापतीनोर्जनं मामुपीतसु कौंसय"
  },
  {
    "start_s": 255,
    "end_s": 263,
    "ctc": "मामुपीत तु कौन्सियाव पुनर्जन्मनभिीध त"
  },
  {
    "start_s": 260,
    "end_s": 268,
    "ctc": "स॒हस्र जुगपद्यन्त्यां मते"
  },
  {
    "start_s": 265,
    "end_s": 273,
    "ctc": "जूवपज्यन्त्यां मरहजगर्मणो वििदुः"
  },
  {
    "start_s": 270,
    "end_s": 278,
    "ctc": "रात्रिं जीवसहस्रान्त्यां तीहोरात्र विदु"
  },
  {
    "start_s": 275,
    "end_s": 283,
    "ctc": "तीहोरात्रमिदूजनः अभभक्त्याद् वक्त्रौ सर्वाः"
  },
  {
    "start_s": 280,
    "end_s": 288,
    "ctc": "अभभक्त्याद् वक्त्रौ सर्वा प्रभवरात्रगमी प्रलीयम्"
  },
  {
    "start_s": 285,
    "end_s": 293,
    "ctc": "रात्रानमे प्रलीयन्ति तत्रैवाप्त बप्रसङ्गते"
  },
  {
    "start_s": 290,
    "end_s": 298,
    "ctc": "भूतग्रामान् सैवान् भृत्या भूत्या प्रविेशः"
  },
  {
    "start_s": 295,
    "end_s": 303,
    "ctc": "ग्राम सैवानुभूत्या भुत्या प्रीयते रात्रागमे वध मार्थ"
  },
  {
    "start_s": 300,
    "end_s": 308,
    "ctc": "व समार्थ प्रवत्त हरानमेस्तस्मात् तु"
  },
  {
    "start_s": 305,
    "end_s": 313,
    "ctc": "परस्तस्मात् तु भावन्य वक्तु वक्त्या सनातनः"
  },
  {
    "start_s": 310,
    "end_s": 318,
    "ctc": "वक्तो वक्त्या सनातन जसः सर्वैषु भूतेषु न स्वःसु न विनः सति"
  },
  {
    "start_s": 315,
    "end_s": 323,
    "ctc": "नभिनः अभक्तो्षर इत्युक्ता समाहू परर"
  },
  {
    "start_s": 320,
    "end_s": 328,
    "ctc": "ो्र इत्युक्ता समाहुः परमाङ्गतिम् यन् प्राप्य न निवर्तन्ति त ध्याम परम्"
  },
  {
    "start_s": 325,
    "end_s": 333,
    "ctc": "य प्राप्य न निवर्तन्ति त ध्याम परमङ्मवःष"
  },
  {
    "start_s": 330,
    "end_s": 338,
    "ctc": "पुरुषा स परप्रार्थौ भक्त्यालम्भः सनन्नयाशान्त"
  },
  {
    "start_s": 335,
    "end_s": 343,
    "ctc": "दृश्यान्तस्थाणि भूताानिि जीना सर्वमिदङ् ततम्"
  },
  {
    "start_s": 340,
    "end_s": 348,
    "ctc": "जीना सर्वमिनङ् ततम् यत्रकालै्तनावृत्ति मावृत्तिं चैव योगिनः"
  },
  {
    "start_s": 345,
    "end_s": 353,
    "ctc": "मावित्तिं चैव योगिनः प्रयाापा यान्ति तं कालं बक्ष्यामि भरतर्षव"
  },
  {
    "start_s": 350,
    "end_s": 358,
    "ctc": "क्ष्याम भरतर्षव अग्नीज्योतीरहं शुक््रशनमास उत्तर"
  },
  {
    "start_s": 355,
    "end_s": 363,
    "ctc": "स नमासा उत्तरायणं तत्तप्रयातगच्छन्ति ब्रह्म ब्रह्मविदू जनाः"
  },
  {
    "start_s": 360,
    "end_s": 368,
    "ctc": "ि ब्रह्मब्रह्मविदो जनाः धूमरास्तीस्तथा कृष्ण"
  },
  {
    "start_s": 365,
    "end_s": 373,
    "ctc": "मरात्रिःस्तथा कृष्णसनमासा दुःखिनारणं तत्र चान्द्रवसङ्गज्योतिो"
  },
  {
    "start_s": 370,
    "end_s": 378,
    "ctc": "तत्र चान्द्रमसहजूति जूगीपापं निवर्तते शुक्लप्रश्ने गतिझ्यीते"
  },
  {
    "start_s": 375,
    "end_s": 383,
    "ctc": "शुक्लप्रश्ने गतिज्जीते जगतः शासते मते कया जात्व नावृत्ति"
  },
  {
    "start_s": 380,
    "end_s": 388,
    "ctc": "क्वया जात्व नावृत्ति मन्यमया वर्तते पुनः"
  },
  {
    "start_s": 385,
    "end_s": 393,
    "ctc": "नैते सिति पाथजाणं जोगी मैिहति कश्चनत्"
  },
  {
    "start_s": 390,
    "end_s": 398,
    "ctc": "य मिहमि इति कश्चन तस्मात् सर्वेषु कालेषु जूगयुक्तभवार्जुन"
  },
  {
    "start_s": 395,
    "end_s": 403,
    "ctc": "बीद सुु जज्ञैसु तपस्सु चैव दानसु जत्पन्न फलं पतिम्"
  },
  {
    "start_s": 400,
    "end_s": 408,
    "ctc": "दानी सृजत्वंन्न फलं प्रदिष्ट्यम् अस्ती तु तत् सर्वमिदं विदित्वा"
  },
  {
    "start_s": 405,
    "end_s": 413,
    "ctc": "य तु तत् सर्वमिदं विदित्वा जोगीपरं स्थानौैति चाद्यम्"
  },
  {
    "start_s": 410,
    "end_s": 418,
    "ctc": "ओ तत् सदिति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मवि्यः"
  },
  {
    "start_s": 415,
    "end_s": 423,
    "ctc": "वद्गीतासुंसत्सु ब्रह्मविद्यायां जूगशास्त्री श्रीकृष्णाजुनसंभारी"
  },
  {
    "start_s": 420,
    "end_s": 428,
    "ctc": "श्री श्रीकृष्णार्जुनसंभादी अक्षर ब्रह्मजूग नामष्टमोध्यायः"
  }
]