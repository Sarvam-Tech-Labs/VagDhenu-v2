[
  {
    "start_s": 0.0,
    "end_s": 10.0,
    "ctc": "आाचाप्तर् भगवद्गीता अर्जुनवाचा ज्यायसी चेत्"
  },
  {
    "start_s": 8.0,
    "end_s": 18.0,
    "ctc": "ज्यायसी चे कर्मणास्ते मता बुद्धिजनार्दन तत्किं कर्मणी"
  },
  {
    "start_s": 16.0,
    "end_s": 26.0,
    "ctc": "तत्किं कर्मणीघोरीमां नियोजयसीकेशव"
  },
  {
    "start_s": 24.0,
    "end_s": 34.0,
    "ctc": "हमशीमेवबाहीनां बुद्धिमोरसीव मे तदेकं वदने"
  },
  {
    "start_s": 32.0,
    "end_s": 42.0,
    "ctc": "एकं वदने स्थित्य येन श्रेयामापं"
  },
  {
    "start_s": 40.0,
    "end_s": 50.0,
    "ctc": "श्रीभगवान् वाच लोकेस्मिन् दिविधा निस"
  },
  {
    "start_s": 48.0,
    "end_s": 58.0,
    "ctc": "पुरा वत्ता मय नह ज्ञानुजूगीनसां"
  },
  {
    "start_s": 56.0,
    "end_s": 66.0,
    "ctc": "ानजोगीेनसाङ्ख्यानां कर्मगेनोगिनां कर्माणाम्"
  },
  {
    "start_s": 64.0,
    "end_s": 74.0,
    "ctc": "न कणामनारम्भ्राः नैः कर्म पुरुषोस्त ते"
  },
  {
    "start_s": 72.0,
    "end_s": 82.0,
    "ctc": "नचासन्नसनाादीव सिद्धिं समधीगच्छति"
  },
  {
    "start_s": 80.0,
    "end_s": 90.0,
    "ctc": "नहिकासित्खनमपि जातूतिथर्तवम्"
  },
  {
    "start_s": 88.0,
    "end_s": 98.0,
    "ctc": "यसूतिश्चचकर्मपि कार्यती ह्यव च कर्म सर्वप्र"
  },
  {
    "start_s": 96.0,
    "end_s": 106.0,
    "ctc": "सर्वप्रकृतीजैगु कर्मन्द्रिणि संयम्य"
  },
  {
    "start_s": 104.0,
    "end_s": 114.0,
    "ctc": "युवास्ते मनसा स्मरन् इन्द्रियार्थान् विमोरम्"
  },
  {
    "start_s": 112.0,
    "end_s": 122.0,
    "ctc": "मर्थान् विमोहरात्मा मिथ्याचारः सौूचति"
  },
  {
    "start_s": 120.0,
    "end_s": 130.0,
    "ctc": "यस्न्द्रियाणि मनसां नियम्यारभतेर्जुनां कर्मे"
  },
  {
    "start_s": 128.0,
    "end_s": 138.0,
    "ctc": "कर्मेन्द्रियैी कर्मजूगाामसचासाभिशीेषति"
  },
  {
    "start_s": 136.0,
    "end_s": 146.0,
    "ctc": "जज्ञाथाः कर्मणो नत्र लोकं करबन्धनं"
  },
  {
    "start_s": 144.0,
    "end_s": 154.0,
    "ctc": "तदक्षं कन्कौन्तीयमुुक्तसङ्घ समाचरौ"
  },
  {
    "start_s": 152.0,
    "end_s": 162.0,
    "ctc": "सहो जज्ञः प्रजहासृष गुरोपास प्रजापतिः"
  },
  {
    "start_s": 160.0,
    "end_s": 170.0,
    "ctc": "च प्रजापति अणेन पृथविः श्रद्ध्यमीशावसीस्तकामधू"
  },
  {
    "start_s": 168.0,
    "end_s": 178.0,
    "ctc": "दीपान् भयतानिीदीपा भयये"
  },
  {
    "start_s": 176.0,
    "end_s": 186.0,
    "ctc": "ीदेवावय परस्परं भावयन्त्यः श्रयः परमव"
  },
  {
    "start_s": 184.0,
    "end_s": 194.0,
    "ctc": "इष्यान् भूवान् हि बोधीवा दस्यन्ति ध"
  },
  {
    "start_s": 192.0,
    "end_s": 202.0,
    "ctc": "दस्यन्ती जग्वभावितः तैदस्यान् सदायुभ्यो ज्वो भुङ्क्ते"
  },
  {
    "start_s": 200.0,
    "end_s": 210.0,
    "ctc": "जो भुं तेस्तीेनयैव च अन्याद् भवन्ति दूताणि"
  },
  {
    "start_s": 208.0,
    "end_s": 218.0,
    "ctc": "पज्जन्यादन्नसम्भवः यज्ञाद भवतीपज्जन्यो"
  },
  {
    "start_s": 216.0,
    "end_s": 226.0,
    "ctc": "ीपजन्ोजज्ञा कर्म समोद्भवः कर्म ब्रह्मादुभवम्"
  },
  {
    "start_s": 224.0,
    "end_s": 234.0,
    "ctc": "ब्रह्माुभं विद्धि ब्रह्माप सर्वसमूद्भवं तस्माः सर्वगतं"
  },
  {
    "start_s": 232.0,
    "end_s": 242.0,
    "ctc": "यस्माः सर्वगतं ब्रह्म मस्तं जेपसीषितम् एवं प्रवर्तितं"
  },
  {
    "start_s": 240.0,
    "end_s": 250.0,
    "ctc": "एवं प्रवर्तितं चक्रं नानुवर्ततीीहजा अभायुनिन्द्य नामम्"
  },
  {
    "start_s": 248.0,
    "end_s": 258.0,
    "ctc": "मोघं पाश सजीवति जस्या स्मरतिरेव च"
  },
  {
    "start_s": 256.0,
    "end_s": 266.0,
    "ctc": "यस्या स्मरतिरेव श्याभ्यात्मतृप्तश्च मानवान् आत्मन्ेव च संन्तुष्य"
  },
  {
    "start_s": 264.0,
    "end_s": 274.0,
    "ctc": "नैव च संन्तुष्ट्यस्तस्य कार्यं न वीदति नैव तस्य कसनार्थु"
  },
  {
    "start_s": 272.0,
    "end_s": 282.0,
    "ctc": "तत्त कतीनाहौ कृतीनःकृतीमीह कश्चनां नचर्थ सर्वसूतेषु"
  },
  {
    "start_s": 280.0,
    "end_s": 290.0,
    "ctc": "भूतेषु कश्चिदर्थमपाश्रयम् तस्मादसत्तः सतत"
  },
  {
    "start_s": 288.0,
    "end_s": 298.0,
    "ctc": "तस्मादसत्तः सततं कार्यं कर्म समाचर असक्तु वाचरं कर्म क"
  },
  {
    "start_s": 296.0,
    "end_s": 306.0,
    "ctc": "माप्नोति पुषः कर्मणैव ही संसिद्धिमाथिता जनता"
  },
  {
    "start_s": 304.0,
    "end_s": 314.0,
    "ctc": "माथिताजनकालयो लोकोः सङ्ग्रहामीवापि सङ्कटं कर्तुमर्हति"
  },
  {
    "start_s": 312.0,
    "end_s": 322.0,
    "ctc": "यद्जदाश्चरदीशै च दत्तदेवीतवौ जनः"
  },
  {
    "start_s": 320.0,
    "end_s": 330.0,
    "ctc": "तदेवीतदौ जनः सज प्रमाणमु कलु लोकस्तदनुवर्तते"
  },
  {
    "start_s": 328.0,
    "end_s": 338.0,
    "ctc": "न मे बाथाासी कर्तभ्यं त्रिषु लोकेषु किञ्चन"
  },
  {
    "start_s": 336.0,
    "end_s": 346.0,
    "ctc": "नणावाप्तमवाप्तव्यं वर्तैव च कर्मणि"
  },
  {
    "start_s": 344.0,
    "end_s": 354.0,
    "ctc": "यदि ध्याङ्नवर्तीयं जातु तन्मन्न तन्द्रिता ममो वत्माणु वर्तन्ति"
  },
  {
    "start_s": 352.0,
    "end_s": 362.0,
    "ctc": "मनुष्या पात सर्वध उ सदयूनिमे लूकाः"
  },
  {
    "start_s": 360.0,
    "end_s": 370.0,
    "ctc": "नकुर्यां कर्मचीरां शङ्करस्य च कस्याश नाहन्"
  },
  {
    "start_s": 368.0,
    "end_s": 378.0,
    "ctc": "न हन्याभिमाप्तयः न बुद्धीभीदं जनै दयाणां कर"
  },
  {
    "start_s": 376.0,
    "end_s": 386.0,
    "ctc": "द्याणां कर्मसञघ्रहां जूथै सर्वकर्माणि विित्यानयुसभत्"
  },
  {
    "start_s": 384.0,
    "end_s": 394.0,
    "ctc": "प्रतिितक्ष्यमाणानि जुनै कर्माणि सर्वसः"
  },
  {
    "start_s": 392.0,
    "end_s": 402.0,
    "ctc": "म अहङ्कारििमूरात्मा कर्त हम् इ मन्नति"
  },
  {
    "start_s": 400.0,
    "end_s": 410.0,
    "ctc": "तत्तविस्तु महाबाहो गुणतमभिभावयौ गुणा गुणैेषुवचन्त्य इति भीमत्याम्"
  },
  {
    "start_s": 408.0,
    "end_s": 418.0,
    "ctc": "प्रकृते गुणसङ्मूळाः सजजन्ते गुणक॒र्मशुते"
  },
  {
    "start_s": 416.0,
    "end_s": 426.0,
    "ctc": "न्त गुणकर्मशु तान कृष्णभिदूमन्याान् कृष्णविन्या विजालेः"
  },
  {
    "start_s": 424.0,
    "end_s": 434.0,
    "ctc": "येम म तमि॒दं नित्यंनुतिशन्ति महानवः स"
  },
  {
    "start_s": 432.0,
    "end_s": 442.0,
    "ctc": "सद्यावन्त न श्रूयन्तमुच्यन्ते तेमि कर्मति"
  },
  {
    "start_s": 440.0,
    "end_s": 450.0,
    "ctc": "देतेे तादभ्य श्रूयन्त नानुतिष्ठन्ति मे मतम् च द्वगणुविम"
  },
  {
    "start_s": 448.0,
    "end_s": 458.0,
    "ctc": "तद्वज्ञानुविमूढाः स्वां वित्सीन शूणशीत"
  },
  {
    "start_s": 456.0,
    "end_s": 466.0,
    "ctc": "सदृशं च सति सस्या प्रविते ज्ञानवानोपि प्रकृतिं"
  },
  {
    "start_s": 464.0,
    "end_s": 474.0,
    "ctc": "प्रकृतिं यान्ति सूताानिि निग्रह किंतरष्यति"
  },
  {
    "start_s": 472.0,
    "end_s": 482.0,
    "ctc": "इन्द्रियाश्चेन्द्रियाश्चार्क्षी रावतीीषौपवस्थितौ"
  },
  {
    "start_s": 480.0,
    "end_s": 490.0,
    "ctc": "तयूर्णपस्मावच्छेत्तौ यत् स परिपंसिनौ"
  },
  {
    "start_s": 488.0,
    "end_s": 498.0,
    "ctc": "स्यो सधर्मविदुनौ पधर्मा समुश्चितौ स्वधर्मे निधनं श्री"
  },
  {
    "start_s": 496.0,
    "end_s": 506.0,
    "ctc": "ममी विधनं श्रीहः परुधर्माभयावहावर्ुच"
  },
  {
    "start_s": 504.0,
    "end_s": 514.0,
    "ctc": "अतः किेन भृजिस्तूयं पापं चरति पूरुष अनिच्छन्नभिबाष्णया बलादेव नियोजितः"
  },
  {
    "start_s": 512.0,
    "end_s": 522.0,
    "ctc": "श्रीभगवानानुवाात् कामैस क्रोधैस रजगूण समुद्भव"
  },
  {
    "start_s": 520.0,
    "end_s": 530.0,
    "ctc": "गजगूनसमुद्भव महासनो महापापमा वित्त नं इहं वैरिनं"
  },
  {
    "start_s": 528.0,
    "end_s": 538.0,
    "ctc": "धूनेनोभ्र्यते बन्नि यथातर्षुेन जथूल्लीनां"
  },
  {
    "start_s": 536.0,
    "end_s": 546.0,
    "ctc": "जथूल्लीनाभ्रतू गर्भः सुखातीनाभत्दम् आवृतं गानमेतेन"
  },
  {
    "start_s": 544.0,
    "end_s": 554.0,
    "ctc": "सभृतं ज्ञानमेतेन ज्ञानिनो निस्तवेण कामरूेण कौसेन दुःसुरेण"
  },
  {
    "start_s": 552.0,
    "end_s": 562.0,
    "ctc": "मुरेनानलेन इन्द्रियाणि मनोबुद्धि"
  },
  {
    "start_s": 560.0,
    "end_s": 570.0,
    "ctc": "इन्द्रस्याभिी स्थानमुच्यते य ति विमोहयात् ती स ग"
  },
  {
    "start_s": 568.0,
    "end_s": 578.0,
    "ctc": "गणमापृष्टधीहिनम् तस्मात्स्तमिन्द्रियान्नादौ"
  },
  {
    "start_s": 576.0,
    "end_s": 586.0,
    "ctc": "इन्द्रियान्नादौ नियम भरतर्षभः पापमाणं तजहि"
  },
  {
    "start_s": 584.0,
    "end_s": 594.0,
    "ctc": "यणां ज्ञानविज्ञानां नासनं इन्द्रणि पराण्याह इन्द्रियेभ्योः परनमत्"
  },
  {
    "start_s": 592.0,
    "end_s": 602.0,
    "ctc": "इन्द्रियभ्योः परममनः मनसस्तु पराबुद्धि जूबुद्धिः परतस्तु सा"
  },
  {
    "start_s": 600.0,
    "end_s": 610.0,
    "ctc": "एवं बुद्धैः परमबुद्ध्या संस्तभ्यात्मा नमात्मना ज ईससं महाबाह"
  },
  {
    "start_s": 608.0,
    "end_s": 618.0,
    "ctc": "जहीससं महाबाह कामरूपं दुरासदम् त श्रीभगवगता"
  },
  {
    "start_s": 616.0,
    "end_s": 626.0,
    "ctc": "भगवद्गीताूपनिशःसु ब्रह्मविदयां योगशात्रै श्रीकृष्णार्जुनसहवेग"
  },
  {
    "start_s": 624.0,
    "end_s": 629.838,
    "ctc": "कर्म यूगनामा तृतीयावधायः"
  }
]