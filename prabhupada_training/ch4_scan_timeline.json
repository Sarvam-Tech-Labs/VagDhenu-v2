[
  {
    "start": 0,
    "end": 10,
    "txt": "कमद्भगवत्सितोस्या श्रभगवानुर्वच इमं विवत्सती"
  },
  {
    "start": 8,
    "end": 18,
    "txt": "इमं विवसती यूगं प्र्तभानहमभयं विवशनोन्मनभिप्राहाम"
  },
  {
    "start": 16,
    "end": 26,
    "txt": "मभिप्राहामनू॑रिकवि्रवि एवं परं प्रप्रापमि"
  },
  {
    "start": 24,
    "end": 34,
    "txt": "प्रापमिमङ्गाजर्षयो विदुः सकालेनीहुमुहता जूवुर्नष्ट परं"
  },
  {
    "start": 32,
    "end": 42,
    "txt": "नष्टप उजनुमा अपरं भवतूजन्म परं"
  },
  {
    "start": 40,
    "end": 50,
    "txt": "भवधूजन्म परं जन्मभिवक्षतः कृथो मैतद् वियाानीयां समादौगमाान्"
  },
  {
    "start": 48,
    "end": 58,
    "txt": "इति भगवान् वा बहुनी मे पदितानिी जनम्"
  },
  {
    "start": 56,
    "end": 66,
    "txt": "े पदितानि जनणी तवचार तान् नहं वीेद सर्वाणी नस्तम् वेक्षपनंन्तम"
  },
  {
    "start": 64,
    "end": 74,
    "txt": "अजो पि सन्न्यभयात् मां भूतानामशरोम्"
  },
  {
    "start": 72,
    "end": 82,
    "txt": "भूतानामितुरूपिसन् प्रतिदष्यामधिष्ठाय सम्भवाम्यात"
  },
  {
    "start": 80,
    "end": 90,
    "txt": "तुय यदा यदतिी धर्मशब््लाणी भवति भारतम्"
  },
  {
    "start": 88,
    "end": 98,
    "txt": "भारतम् अभुतानमधर्मस्य कदा समानं सृजामहम्"
  },
  {
    "start": 96,
    "end": 106,
    "txt": "परित्राणाय साधुनां विनाशाय च दुष्कृतां धर्मम्"
  },
  {
    "start": 104,
    "end": 114,
    "txt": "ां धर्मसंस्थापनार्थाय सम्भवान्ीी"
  },
  {
    "start": 112,
    "end": 122,
    "txt": "जन्मकर्म च मे दिव्यामेवं जोर्वत्तित तस"
  },
  {
    "start": 120,
    "end": 130,
    "txt": "तस्यापिहं पुनर्जन्म नैतिमामििति कौस्य"
  },
  {
    "start": 128,
    "end": 138,
    "txt": "विितुरावुभयक्रूढा मन्वयामामुपासितः"
  },
  {
    "start": 136,
    "end": 146,
    "txt": "बहुवू ज्ञानुतमसो भूतो मदो भावमा कृतः"
  },
  {
    "start": 144,
    "end": 154,
    "txt": "ये यथा मां प्रवदन्ते तांस्तथैव भजामामहम्"
  },
  {
    "start": 152,
    "end": 162,
    "txt": "ममो वत्व्वानुवर्तन्ति मनुष्या पास सर्वसः"
  },
  {
    "start": 160,
    "end": 170,
    "txt": "काङ्खन्तकरुणां सिद्धिं व्यजन्तपिभुतः"
  },
  {
    "start": 168,
    "end": 178,
    "txt": "क्षिप्रं ही मानुसे लोके सिद्धे भवति कर्मयाम्"
  },
  {
    "start": 176,
    "end": 186,
    "txt": "नमाङ् कर्माणि लिम्पन्ती नमे कर्मफले स्यः"
  },
  {
    "start": 184,
    "end": 194,
    "txt": "इतिधीमांजोभिजनाति कर्मभीण स बद्धते"
  },
  {
    "start": 192,
    "end": 202,
    "txt": "एवं गत्वा कृतं कर्म उुद््बैरभीमुमोक्षुभि"
  },
  {
    "start": 200,
    "end": 210,
    "txt": "कुरुकर्मैव तस्मात् तं पूर्वै पूर्वोत्तरं कृतम्"
  },
  {
    "start": 208,
    "end": 218,
    "txt": "किं कर्मा किमकर्मेति गबयुः पत्रबूहिता"
  },
  {
    "start": 216,
    "end": 226,
    "txt": "तस्तै कर्म प्रवक्ष्यामि जडज्ञनस्या मोक्षसी सुभार्म"
  },
  {
    "start": 224,
    "end": 234,
    "txt": "कर्मणो य्यपि बोद्धव्य्यंञ्च्याभिकार्मणाम्"
  },
  {
    "start": 232,
    "end": 242,
    "txt": "अकर्मणश्च बोद्ध्यव्यं गहनाःकर्मणो गतिः"
  },
  {
    "start": 240,
    "end": 250,
    "txt": "कर्माण य आपश्येत् नकर्मणी च कर्मयः"
  },
  {
    "start": 248,
    "end": 258,
    "txt": "न कर्मणी च कर्मजः स बुद्धिमान्मनुष्येषु सजुषा कृष्णकर्मकी"
  },
  {
    "start": 256,
    "end": 266,
    "txt": "य स सर्वी समारम्भाः कामसङ्कल्पवर्जिताः"
  },
  {
    "start": 264,
    "end": 274,
    "txt": "ल्पपरिजिता ज्ञानग्नीदग्धकर्र्मानं समाहूण्वितं बु"
  },
  {
    "start": 272,
    "end": 282,
    "txt": "ु तस्याकर्मफलासङ्गं निततृप्तो"
  },
  {
    "start": 280,
    "end": 290,
    "txt": "निततृप्तो निराश्रया कर्मन्नभि प्रविशोकी नैव कन्"
  },
  {
    "start": 288,
    "end": 298,
    "txt": "नैव कं किञ्चि करोति स निराशी चतिति समात्मा"
  },
  {
    "start": 296,
    "end": 306,
    "txt": "मा सप्तसर्वपरिग्रहा शारिरं केवलं कर्म कुर्बन्ना"
  },
  {
    "start": 304,
    "end": 314,
    "txt": "कुर्पन्नाप्नतििकी जदिच्यालावशन्तुस्तु"
  },
  {
    "start": 312,
    "end": 322,
    "txt": "िथ्यालावसन्तुष्टो सन्धासीतो विमसर सवसिद्ध्यावसिद्धौ च भत्यापि"
  },
  {
    "start": 320,
    "end": 330,
    "txt": "ित्यापन निबति गतः सङ्गस्य मुक्तस्य ज्ञान बति"
  },
  {
    "start": 328,
    "end": 338,
    "txt": "ज्ञानभस्थितसीतस जज्ञायाा्चरसूः कर्म समग्रं सविज"
  },
  {
    "start": 336,
    "end": 346,
    "txt": "ब्रह्मार्पणं ब्रह्महवी ब्रह्माग्नौ ब्रह्मणा हुतौै"
  },
  {
    "start": 344,
    "end": 354,
    "txt": "ग्नौ ब्रह्मणहुतम् ब्रह्मै ननेन गन्तव्य्यं ब्रह्मकर्मसमाधिनाम्"
  },
  {
    "start": 352,
    "end": 362,
    "txt": "दैवमिवापरीजं यूगिनो पर्युपासती"
  },
  {
    "start": 360,
    "end": 370,
    "txt": "ब्रह्माग्नाापपरीह्यस्य जगीनै गोपजूहति"
  },
  {
    "start": 368,
    "end": 378,
    "txt": "सूत्रादीनिन्द्रियान् संङ्गमानान्न सुजूहति"
  },
  {
    "start": 376,
    "end": 386,
    "txt": "सप्तादिं विषयानन्य इन्द्र्याग्नेे सुजूवती"
  },
  {
    "start": 384,
    "end": 394,
    "txt": "सर्वाणी इन्द्रियकर्माणि प्राणकर्माणि चापः"
  },
  {
    "start": 392,
    "end": 402,
    "txt": "माणकर्म निशापरे आपसंकमजूगग्नौ जुवती ज्ञानदीकृते"
  },
  {
    "start": 400,
    "end": 410,
    "txt": "दृव्यजज्ञा कपूजज्ञा योगजिज्ञास्तथा परे श्रादधाः"
  },
  {
    "start": 408,
    "end": 418,
    "txt": "श्राद्धायो ज्ञानजज्ञास्य जतयूशंसितभ्रृतः"
  },
  {
    "start": 416,
    "end": 426,
    "txt": "अपाणे जोवती प्राणं प्राणे पाणं तथा पररे"
  },
  {
    "start": 424,
    "end": 434,
    "txt": "प्राणापाणगतीरुद्या प्राणायामोपायण अपरण"
  },
  {
    "start": 432,
    "end": 442,
    "txt": "अपरी निरताहारा प्राणाणां प्राणी सुजुवति सर्वे प्रीते जगवीदौ"
  },
  {
    "start": 440,
    "end": 450,
    "txt": "ी जविद जज्ञ कपिितकल्मषा जज्ञासिश्चांसो"
  },
  {
    "start": 448,
    "end": 458,
    "txt": "जज्ञासि शांसो भूजो श्यान्ति ब्रह्मसनातनम् नायं लूकसजज्ञस्य"
  },
  {
    "start": 456,
    "end": 466,
    "txt": "जज्ञस्य कुतनज्ञ कुरुषत्तमाम् एवं बहुविधा जज्ञां वसृता"
  },
  {
    "start": 464,
    "end": 474,
    "txt": "वसृता ब्रह्मणोमुखे कर्मजाण विद्धितान् सर्वानैव व्यर्था विमुोक्ष्यते"
  },
  {
    "start": 472,
    "end": 482,
    "txt": "र्रियाान्दृत्वमया जज्ञा ज्ञानजगज्ञति"
  },
  {
    "start": 480,
    "end": 490,
    "txt": "ज्ञानजगाः परं तप सर्वं कर्माखिलं प्रस्य ज्ञाने परी"
  },
  {
    "start": 488,
    "end": 498,
    "txt": "ज्ञाने प समापति तस्ितीपणिपापेन परिप्रश्नेन सेवयाम्"
  },
  {
    "start": 496,
    "end": 506,
    "txt": "उपदीक्षन्ति ते ज्ञानं ज्ञानिना स"
  },
  {
    "start": 504,
    "end": 514,
    "txt": "जज्ञस्या पुनः पुनोहामीवं जास्यपम्"
  },
  {
    "start": 512,
    "end": 522,
    "txt": "ह मीमं जाः श्रुतिपाण्डवौ वीनभूतान्नशीसीन दृः कश्यात्मन्न तौ"
  },
  {
    "start": 520,
    "end": 530,
    "txt": "अपि चेदसी पापिभ्य सर्विभ्य पापकोम्"
  },
  {
    "start": 528,
    "end": 538,
    "txt": "सभ्य सर्विभ्यो पापकृत्तम सर्वं ज्ञानुप्रवीनैव प्रजीनं शंन्तरीर्षसिी"
  },
  {
    "start": 536,
    "end": 546,
    "txt": "यथैधांसी समीभो बष््मश्वात्सुरुतीर्जुन"
  },
  {
    "start": 544,
    "end": 554,
    "txt": "स्वतीुनौ ग्यणामी सर्वकनुणी भस््म स्वात्सृती तथा"
  },
  {
    "start": 552,
    "end": 562,
    "txt": "नहि ज्ञानीनाः सदृशं ववित्तामिह विदति तत्क्षणम्"
  },
  {
    "start": 560,
    "end": 570,
    "txt": "तत्ष जू संसिद्ध्य कालीनाात्मनि विन्दति"
  },
  {
    "start": 568,
    "end": 578,
    "txt": "सद्यावां लवति ज्ञानं तत्परसजतीन्द्रियः"
  },
  {
    "start": 576,
    "end": 586,
    "txt": "ज्ञानं लभ्या परंः श्रान्तीमचीरेणाधिगच्छतित्"
  },
  {
    "start": 584,
    "end": 594,
    "txt": "अजग्नश्च्यासप्रधानश्च संसयात्महाापनस्तति"
  },
  {
    "start": 592,
    "end": 602,
    "txt": "नायं लोकस्ति न परो न सुखं संशयात्मन"
  },
  {
    "start": 600,
    "end": 610,
    "txt": "योगौ संमष्टकर्माणं गण सक्षिनम्"
  },
  {
    "start": 608,
    "end": 618,
    "txt": "व्याणां सङ्च्छिन्नस सयम् आभवन्तङ्नकर्माणि निवध्नन्ति धनम्"
  },
  {
    "start": 616,
    "end": 626,
    "txt": "धनञ्जय तस्माद््ञान सम्भूतंम्"
  },
  {
    "start": 624,
    "end": 634,
    "txt": "शिं ज्ञानासनात्मना चित्तेन संशयं योगवाप"
  },
  {
    "start": 632,
    "end": 642,
    "txt": "मास्तिष्ठोत्तिष्ठमाहरत तर्थ श्रीसमरभगोदितासु पुंषःसु"
  },
  {
    "start": 640,
    "end": 650,
    "txt": "ु ब्रह्मविदयां जूवशास्त्री श्रीकृष्णार्शुनसंवादी ज्ञानकर्मसन्न्यासजूव"
  },
  {
    "start": 648,
    "end": 652.6955416666667,
    "txt": "ज्ञानकर्मसन्न्यासजूुनामा चतुस्तवथाया"
  }
]